/*TRUEHOPE-UPDATE {"id":"th-password-eye-20261120","name":"Show Password Eye Button","version":"1.0","date":"2026-11-20","description":"Adds an eye button next to every password box (login, change password, users) to show or hide the password."} */
(function () {
  TH.css(
    ".th-pw-wrap{position:relative;display:block;width:100%}" +
    ".th-pw-wrap>input{width:100%;padding-right:40px !important;box-sizing:border-box}" +
    ".th-pw-eye{position:absolute;right:6px;top:50%;transform:translateY(-50%);border:0;background:transparent;" +
    "cursor:pointer;padding:4px 6px;line-height:0;color:#555;border-radius:6px}" +
    ".th-pw-eye:hover{background:rgba(0,0,0,.07);color:#1e3a5f}" +
    ".th-pw-eye svg{width:20px;height:20px}" +
    "@media print{.th-pw-eye{display:none}}"
  );

  var EYE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>';
  var EYE_OFF = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19C5 19 1 12 1 12a18.5 18.5 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 7 11 7a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';

  function addEye(inp) {
    if (inp.getAttribute("data-th-eye")) return;
    inp.setAttribute("data-th-eye", "1");
    var wrap = document.createElement("span");
    wrap.className = "th-pw-wrap";
    inp.parentNode.insertBefore(wrap, inp);
    wrap.appendChild(inp);
    var b = document.createElement("button");
    b.type = "button";
    b.className = "th-pw-eye";
    b.title = "Show password";
    b.tabIndex = -1;
    b.innerHTML = EYE;
    b.addEventListener("mousedown", function (e) { e.preventDefault(); }); // keep cursor in box
    b.addEventListener("click", function (e) {
      e.preventDefault(); e.stopPropagation();
      var show = inp.type === "password";
      inp.type = show ? "text" : "password";
      b.innerHTML = show ? EYE_OFF : EYE;
      b.title = show ? "Hide password" : "Show password";
      inp.focus();
    });
    wrap.appendChild(b);
  }

  function scan() {
    var list = document.querySelectorAll('input[type="password"]:not([data-th-eye])');
    for (var i = 0; i < list.length; i++) addEye(list[i]);
  }

  var t = null;
  new MutationObserver(function () { clearTimeout(t); t = setTimeout(scan, 50); })
    .observe(document.documentElement, { childList: true, subtree: true });
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", scan); else scan();
})();
/*TH-SIGN:718e350521a723b8819d256ff5adc472*/
