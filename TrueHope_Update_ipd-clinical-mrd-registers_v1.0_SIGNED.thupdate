const LEGAL_SHORT = () => `© ${new Date().getFullYear()} TRUE HOPE HEALTHCARE SOLUTIONS. All rights reserved. This software is the property of True Hope Healthcare Solutions and is licensed for use only. Unauthorised copying, resale, modification or reverse engineering is prohibited. Subject to ${db.settings.legalCity ? esc(db.settings.legalCity) + ' jurisdiction' : 'the jurisdiction of the courts at the registered office of True Hope Healthcare Solutions'} only.`;
TH.addMenuItem('set', 'about', 'About, Ownership & Legal');
TH.page('about', () => `<h2>About, Ownership &amp; Legal Notice</h2><div class="card lgbox">
 <h3 style="margin-top:0">${esc(db.settings.brandName || 'TRUE HOPE DIGITAL SOLUTIONS')} — Hospital Management Software</h3>
 <p><b>Developed, owned and published by:</b> TRUE HOPE HEALTHCARE SOLUTIONS<br>${esc(db.settings.brandSupport || '')}</p>
 <p><b>1. Ownership &amp; copyright.</b> This software, its design, source code, screens, formats, forms, reports and updates are the exclusive intellectual property of True Hope Healthcare Solutions. © ${new Date().getFullYear()} True Hope Healthcare Solutions. All rights reserved.</p>
 <p><b>2. Licence.</b> The hospital / user is granted a non-exclusive, non-transferable licence to use this software for its own internal hospital work only. The software is not sold; it is licensed.</p>
 <p><b>3. Restrictions.</b> Copying, sharing, reselling, renting, re-branding, modifying, decompiling or reverse engineering this software (fully or partly), or removing this notice, without written permission of True Hope Healthcare Solutions is strictly prohibited and may lead to civil and criminal action under the Copyright Act, 1957 and the Information Technology Act, 2000.</p>
 <p><b>4. Data.</b> All patient and hospital data entered belongs to the hospital. The hospital is responsible for keeping regular backups, protecting passwords and maintaining patient confidentiality as per applicable Indian laws, including the Digital Personal Data Protection Act, 2023.</p>
 <p><b>5. Clinical responsibility.</b> This software is a record-keeping and administrative tool. All clinical decisions, prescriptions and treatment remain the sole responsibility of the treating doctors and the hospital.</p>
 <p><b>6. Warranty.</b> The software is provided "as is". True Hope Healthcare Solutions is not liable for any loss of data or business arising from misuse, hardware failure, deletion of browser data or failure to take backups.</p>
 <p><b>7. Jurisdiction.</b> Any dispute is subject to ${db.settings.legalCity ? '<b>' + esc(db.settings.legalCity) + '</b> jurisdiction' : 'the exclusive jurisdiction of the courts at the registered office of True Hope Healthcare Solutions'} only.</p></div>
 ${isM() ? `<div class="card row"><div><label>Jurisdiction city (for legal note)</label><input id="lgc" value="${esc(db.settings.legalCity)}" placeholder="e.g. Amravati, Maharashtra"></div><button class="btn" onclick="db.settings.legalCity=val('lgc');save();toast('Saved');go('about')">Save</button></div>` : ''}`, null);
function legalFooter() { const m = document.getElementById('main'); if (m && !document.getElementById('thLegal')) m.insertAdjacentHTML('beforeend', `<div id="thLegal">${LEGAL_SHORT()} <a href="#" onclick="go('about');return false">Legal notice</a></div>`); }
(function loginLegal() { const s = document.getElementById('lgSup'); if (s && !document.getElementById('thLegalLg')) s.insertAdjacentHTML('afterend', `<div id="thLegalLg" style="font-size:10.5px;color:var(--mut);margin-top:8px;max-width:380px">© ${new Date().getFullYear()} TRUE HOPE HEALTHCARE SOLUTIONS. All rights reserved. Licensed software — unauthorised copying or resale prohibited.</div>`); })();

/* =========================================================
   9. PAGE HOOK (dropdowns + legal footer on every screen)
   ========================================================= */
TH.after('go', () => { try { clEnhance(); } catch (e) { } try { legalFooter(); } catch (e) { } });
