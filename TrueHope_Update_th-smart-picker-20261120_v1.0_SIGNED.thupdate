/*TRUEHOPE-UPDATE {"id":"th-smart-picker-20261120","name":"Smart Picker (multi-select lists)","version":"1.0","date":"2026-11-20","description":"Replaces every pick-list (complaints, findings, diagnosis, advice, medicines, doctors…) with a professional picker: search, tick many options, add your own, OK adds all at once. Single-value fields pick with one click. Typing in the box still works."} */
(function () {
  if (window.__thPK) return;
  window.__thPK = true;

  function E(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
  var wait = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };

  TH.css([
    ".thpk-in{cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,#1d4f91 50%),linear-gradient(135deg,#1d4f91 50%,transparent 50%) !important;background-position:calc(100% - 18px) 50%,calc(100% - 12px) 50% !important;background-size:6px 6px,6px 6px !important;background-repeat:no-repeat !important;padding-right:30px !important}",
    ".thpk-ov{position:fixed;inset:0;z-index:2147482600;background:rgba(15,23,42,.55);display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(2px)}",
    ".thpk{background:#fff;border-radius:18px;width:min(860px,100%);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 24px 70px rgba(0,0,0,.35);overflow:hidden;font-family:inherit}",
    ".thpk-h{background:linear-gradient(135deg,#0b2545,#1d4f91);color:#fff;padding:14px 18px;display:flex;align-items:center;gap:10px}",
    ".thpk-h b{font-size:18px;flex:1}.thpk-h small{opacity:.85;font-size:12px}",
    ".thpk-x{background:rgba(255,255,255,.15);border:0;color:#fff;width:34px;height:34px;border-radius:50%;font-size:18px;cursor:pointer}",
    ".thpk-s{padding:12px 18px 8px;display:flex;gap:8px;align-items:center;border-bottom:1px solid #eef2f7}",
    ".thpk-s input{flex:1;width:auto !important;height:42px;border:1.5px solid #cbd5e1;border-radius:12px;padding:0 14px;font-size:15px;outline:none}",
    ".thpk-s input:focus{border-color:#1d4f91;box-shadow:0 0 0 3px rgba(29,79,145,.15)}",
    ".thpk-s button,.thpk-f button{height:40px;border-radius:10px;padding:0 14px;font-weight:700;cursor:pointer;border:1px solid #cbd5e1;background:#fff;color:#0b2545;white-space:nowrap}",
    ".thpk-sel{padding:8px 18px;display:flex;flex-wrap:wrap;gap:6px;min-height:20px;background:#f8fafc;border-bottom:1px solid #eef2f7}",
    ".thpk-sel span{background:#0b2545;color:#fff;border-radius:16px;padding:4px 6px 4px 11px;font-size:12.5px;display:inline-flex;align-items:center;gap:6px}",
    ".thpk-sel span i{font-style:normal;cursor:pointer;background:rgba(255,255,255,.2);border-radius:50%;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;font-size:11px}",
    ".thpk-sel em{color:#94a3b8;font-size:12.5px}",
    ".thpk-l{overflow:auto;padding:12px 18px;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px;flex:1}",
    ".thpk-o{display:flex;align-items:center;gap:10px;border:1.5px solid #e2e8f0;border-radius:12px;padding:10px 12px;cursor:pointer;font-size:14px;color:#1e293b;background:#fff;transition:all .12s;user-select:none}",
    ".thpk-o:hover{border-color:#93c5fd;background:#f0f7ff}",
    ".thpk-o .ck{width:20px;height:20px;border-radius:6px;border:2px solid #94a3b8;flex:none;display:flex;align-items:center;justify-content:center;font-size:13px;color:#fff}",
    ".thpk-o.on{border-color:#1d4f91;background:#eff6ff;font-weight:700}.thpk-o.on .ck{background:#1d4f91;border-color:#1d4f91}",
    ".thpk-o.single .ck{border-radius:50%}",
    ".thpk-o small{display:block;color:#64748b;font-weight:400;font-size:11.5px}",
    ".thpk-o.new{border-style:dashed;color:#1d4f91}",
    ".thpk-e{grid-column:1/-1;text-align:center;color:#94a3b8;padding:20px}",
    ".thpk-f{padding:12px 18px;border-top:1px solid #eef2f7;display:flex;gap:8px;align-items:center;background:#f8fafc}",
    ".thpk-f .cnt{flex:1;font-size:13px;color:#475569}",
    ".thpk-f .ok{background:#16a34a;border-color:#16a34a;color:#fff;padding:0 22px;font-size:15px}"
  ].join(""));

  /* ---------- find the label text for a field ---------- */
  function labelOf(inp) {
    var ph = inp.getAttribute("placeholder") || "";
    var m = ph.match(/Pick from (.+?) list/i); if (m) return m[1];
    var p = inp.previousElementSibling;
    for (var i = 0; i < 4 && p; i++, p = p.previousElementSibling) if (p.tagName === "LABEL" || /^(B|STRONG|H\d)$/.test(p.tagName)) return (p.textContent || "").trim();
    var lab = inp.parentElement && inp.parentElement.querySelector("label");
    if (lab) return (lab.textContent || "").trim();
    var b = inp.closest("div") && inp.closest("div").previousElementSibling;
    return b && b.textContent && b.textContent.length < 60 ? b.textContent.trim() : (ph || "Select");
  }
  function isMulti(inp) { return /enter/i.test(inp.getAttribute("placeholder") || "") || /pick from/i.test(inp.getAttribute("placeholder") || ""); }
  function optionsOf(inp) {
    var dl = document.getElementById(inp.getAttribute("data-thlist") || "");
    if (!dl) return [];
    var seen = {}, out = [];
    Array.prototype.forEach.call(dl.querySelectorAll("option"), function (o) {
      var v = (o.value || o.textContent || "").trim(); if (!v || seen[v.toLowerCase()]) return;
      seen[v.toLowerCase()] = 1; var t = (o.textContent || "").trim();
      out.push({ v: v, sub: t && t !== v ? t : "" });
    });
    return out;
  }

  /* ---------- picker ---------- */
  var S = null;
  function open(inp) {
    if (document.querySelector(".thpk-ov")) return;
    var multi = isMulti(inp);
    S = { inp: inp, multi: multi, list: optionsOf(inp), sel: [], q: "", title: labelOf(inp) };
    if (!multi && inp.value.trim()) S.sel = [inp.value.trim()];
    var ov = document.createElement("div"); ov.className = "thpk-ov";
    ov.innerHTML = '<div class="thpk"><div class="thpk-h"><div style="flex:1"><b>' + E(S.title.replace(/[:*]\s*$/, "")) + "</b><br><small>" + (multi ? "Tick all that apply, then press OK" : "Click one option") + " · " + S.list.length + ' options</small></div><button type="button" class="thpk-x" title="Close (Esc)">✕</button></div>' +
      '<div class="thpk-s"><input class="q" placeholder="🔍 Search or type a new option…" autocomplete="off">' + (multi ? '<button type="button" class="all">Tick all shown</button><button type="button" class="clr">Clear</button>' : "") + "</div>" +
      (multi ? '<div class="thpk-sel"></div>' : "") + '<div class="thpk-l"></div>' +
      '<div class="thpk-f"><span class="cnt"></span><button type="button" class="cn">Cancel</button>' + (multi ? '<button type="button" class="ok">OK — add selected</button>' : "") + "</div></div>";
    document.body.appendChild(ov);
    var q = ov.querySelector(".q");
    q.oninput = function () { S.q = q.value; paint(); };
    q.onkeydown = function (e) {
      if (e.key === "Enter") { e.preventDefault(); var t = q.value.trim(); if (!t) { if (multi) finish(); return; }
        var hit = S.list.filter(function (o) { return o.v.toLowerCase() === t.toLowerCase(); })[0];
        toggle(hit ? hit.v : t); if (multi) { q.value = ""; S.q = ""; paint(); } }
      if (e.key === "Escape") close();
    };
    ov.querySelector(".thpk-x").onclick = close; ov.querySelector(".cn").onclick = close;
    ov.addEventListener("mousedown", function (e) { if (e.target === ov) close(); });
    if (multi) {
      ov.querySelector(".ok").onclick = finish;
      ov.querySelector(".all").onclick = function () { shown().forEach(function (o) { if (S.sel.indexOf(o.v) < 0) S.sel.push(o.v); }); paint(); };
      ov.querySelector(".clr").onclick = function () { S.sel = []; paint(); };
    }
    paint();
    setTimeout(function () { q.focus(); }, 30);
  }
  function shown() { var t = S.q.trim().toLowerCase(); return S.list.filter(function (o) { return !t || (o.v + " " + o.sub).toLowerCase().indexOf(t) >= 0; }); }
  function paint() {
    var ov = document.querySelector(".thpk-ov"); if (!ov) return;
    var L = shown(), t = S.q.trim(), exact = S.list.some(function (o) { return o.v.toLowerCase() === t.toLowerCase(); });
    var h = L.map(function (o) {
      var on = S.sel.indexOf(o.v) >= 0;
      return '<div class="thpk-o' + (on ? " on" : "") + (S.multi ? "" : " single") + '" data-v="' + E(o.v) + '"><span class="ck">' + (on ? "✔" : "") + "</span><span>" + E(o.v) + (o.sub ? "<small>" + E(o.sub) + "</small>" : "") + "</span></div>";
    }).join("");
    if (t && !exact) h = '<div class="thpk-o new" data-v="' + E(t) + '"><span class="ck" style="border-style:dashed">+</span><span>Add “' + E(t) + '”<small>new — not in the list</small></span></div>' + h;
    ov.querySelector(".thpk-l").innerHTML = h || '<div class="thpk-e">No option found</div>';
    Array.prototype.forEach.call(ov.querySelectorAll(".thpk-o"), function (d) { d.onclick = function () { toggle(d.getAttribute("data-v")); if (d.classList.contains("new") && S && S.multi) { S.q = ""; ov.querySelector(".q").value = ""; paint(); } }; });
    if (S.multi) {
      ov.querySelector(".thpk-sel").innerHTML = S.sel.length ? S.sel.map(function (v, i) { return "<span>" + E(v) + '<i data-i="' + i + '">✕</i></span>'; }).join("") : "<em>Nothing selected yet</em>";
      Array.prototype.forEach.call(ov.querySelectorAll(".thpk-sel i"), function (x) { x.onclick = function () { S.sel.splice(+x.getAttribute("data-i"), 1); paint(); }; });
      ov.querySelector(".cnt").textContent = S.sel.length + " selected";
      ov.querySelector(".ok").disabled = !S.sel.length;
    } else ov.querySelector(".cnt").textContent = L.length + " shown";
  }
  function toggle(v) {
    if (!S) return;
    if (!S.multi) { setSingle(S.inp, v); close(); return; }
    var i = S.sel.indexOf(v); if (i >= 0) S.sel.splice(i, 1); else S.sel.push(v);
    paint();
  }
  function close() { var ov = document.querySelector(".thpk-ov"); if (ov) ov.remove(); S = null; }
  function fire(el, type) { el.dispatchEvent(new Event(type, { bubbles: true })); }
  function key(el, k) {
    ["keydown", "keypress", "keyup"].forEach(function (t) {
      var ev = new KeyboardEvent(t, { key: k, code: k, keyCode: 13, which: 13, bubbles: true, cancelable: true });
      try { Object.defineProperty(ev, "keyCode", { get: function () { return 13; } }); Object.defineProperty(ev, "which", { get: function () { return 13; } }); } catch (e) {}
      el.dispatchEvent(ev);
    });
  }
  function setSingle(inp, v) { inp.value = v; fire(inp, "input"); fire(inp, "change"); inp.focus(); }

  /* the textarea this pick-list writes into (the box just above it) */
  function targetArea(inp) {
    var n = inp.previousElementSibling;
    for (var i = 0; i < 4 && n; i++, n = n.previousElementSibling) { if (n.tagName === "TEXTAREA") return n; var t = n.querySelector && n.querySelector("textarea"); if (t) return t; }
    var box = inp.parentElement; return box ? box.querySelector("textarea") : null;
  }
  function relocate(old) {
    if (old && document.body.contains(old)) return old;
    var id = old && (old.getAttribute("data-thlist") || old.getAttribute("list")), ph = old && old.getAttribute("placeholder");
    return document.querySelector('input[data-thlist="' + id + '"][placeholder="' + (ph || "").replace(/"/g, '\\"') + '"]') || document.querySelector('input[list="' + id + '"]') || old;
  }
  async function addOne(inp, v) {
    inp = relocate(inp);
    var ta = targetArea(inp), before = ta ? ta.value : null, box = inp.closest(".card") || inp.parentElement, html = box ? box.innerHTML.length : 0;
    inp.value = v; fire(inp, "input");
    key(inp, "Enter");
    await wait(40);
    inp = relocate(inp);
    var ta2 = targetArea(inp) || ta;
    var done = (ta2 && ta2.value !== before) || inp.value.trim() !== v || (box && box.innerHTML.length !== html && !(ta2 && ta2.value === before && inp.value === v));
    if (!done && ta2) {   // the software did not take it — write it into the box ourselves
      var cur = ta2.value.replace(/\s+$/, "");
      if ((", " + cur.toLowerCase() + ",").indexOf(", " + v.toLowerCase() + ",") < 0 && cur.split(/\n/).map(function (x) { return x.trim().toLowerCase(); }).indexOf(v.toLowerCase()) < 0)
        ta2.value = cur ? cur + (/\n/.test(cur) ? "\n" : ", ") + v : v;
      fire(ta2, "input"); fire(ta2, "change");
      inp.value = ""; fire(inp, "input");
    } else if (inp.value.trim() === v) { inp.value = ""; fire(inp, "input"); }
    return inp;
  }
  async function finish() {
    if (!S || !S.sel.length) return;
    var inp = S.inp, vals = S.sel.slice();
    close();
    for (var i = 0; i < vals.length; i++) { inp = await addOne(inp, vals[i]); await wait(30); }
    try { toast(vals.length + " added"); } catch (e) {}
  }

  /* ---------- take over every input that has a pick-list ---------- */
  function prep(inp) {
    if (inp.__thpk) return;
    var id = inp.getAttribute("list"); if (!id) return;
    inp.__thpk = 1;
    inp.setAttribute("data-thlist", id);
    inp.removeAttribute("list");                       // stop the plain browser dropdown
    inp.classList.add("thpk-in");
    inp.setAttribute("autocomplete", "off");
    inp.addEventListener("mousedown", function (e) {
      if (e.button !== 0) return;
      var r = inp.getBoundingClientRect();
      if (isMulti(inp) || e.clientX > r.right - 34 || !inp.value) { e.preventDefault(); open(inp); }
    });
    inp.addEventListener("keydown", function (e) { if ((e.key === "ArrowDown" && e.altKey) || e.key === "F4") { e.preventDefault(); open(inp); } });
  }
  var tm = null;
  function scan() { Array.prototype.forEach.call(document.querySelectorAll("input[list]"), prep); }
  new MutationObserver(function () { clearTimeout(tm); tm = setTimeout(scan, 120); }).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ["list"] });
  setTimeout(scan, 400);
  window.thPicker = { open: open };
})();
