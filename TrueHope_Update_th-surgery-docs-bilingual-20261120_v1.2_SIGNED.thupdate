    "investigations": ["तपासण्या", "जांचें"], "investigation": ["तपासणी", "जांच"], "treatment": ["उपचार", "उपचार"], "treatment given": ["दिलेले उपचार", "दिया गया उपचार"],
    "advice": ["सल्ला", "सलाह"], "advice on discharge": ["डिस्चार्जवेळी सल्ला", "छुट्टी के समय सलाह"], "follow up": ["पुन्हा तपासणी", "पुनः जांच"], "follow-up": ["पुन्हा तपासणी", "पुनः जांच"],
