    "ipd no": ["आयपीडी क्र.", "आईपीडी नं."], "ipd no.": ["आयपीडी क्र.", "आईपीडी नं."], "opd no": ["ओपीडी क्र.", "ओपीडी नं."], "opd no.": ["ओपीडी क्र.", "ओपीडी नं."],
    "date of admission": ["दाखल दिनांक", "भर्ती दिनांक"], "admission date": ["दाखल दिनांक", "भर्ती दिनांक"], "doa": ["दाखल दिनांक", "भर्ती दिनांक"],
    "date of discharge": ["डिस्चार्ज दिनांक", "छुट्टी दिनांक"], "discharge date": ["डिस्चार्ज दिनांक", "छुट्टी दिनांक"], "dod": ["डिस्चार्ज दिनांक", "छुट्टी दिनांक"],
