/* sample-specific entries: urine / stool parameters that share a name with a blood parameter */
PLIB['albumin (urine)'] = ['', '', '', 'Nil']; PLIB['protein (urine)'] = ['', '', '', 'Nil']; PLIB['colour (stool)'] = ['', '', '', 'Brown']; PLIB['appearance (stool)'] = ['', '', '', 'Formed'];
const PALIAS = { 'hb': 'haemoglobin', 'hemoglobin': 'haemoglobin', 'tlc': 'total wbc count', 'wbc': 'total wbc count', 'total leucocyte count': 'total wbc count', 'platelets': 'platelet count', 'rbc': 'rbc count', 'pcv': 'pcv / haematocrit', 'hct': 'pcv / haematocrit', 'esr': 'esr (westergren, 1 hr)', 'rbs': 'random blood sugar', 'fbs': 'fasting blood sugar', 'ppbs': 'post-prandial blood sugar', 'urea': 'blood urea', 'creatinine': 'serum creatinine', 'sgot': 'sgot (ast)', 'ast': 'sgot (ast)', 'sgpt': 'sgpt (alt)', 'alt': 'sgpt (alt)', 'alp': 'alkaline phosphatase', 'crp': 'c-reactive protein', 'pt': 'prothrombin time', 'calcium': 'serum calcium', 'hdl': 'hdl cholesterol', 'ldl': 'ldl cholesterol', 'cholesterol': 'total cholesterol', 'tg': 'triglycerides', 'ferritin': 'serum ferritin', 'iron': 'serum iron', 'amylase': 'serum amylase', 'lipase': 'serum lipase', 'b12': 'vitamin b12', 'vit d': 'vitamin d (25-oh)', 'vitamin d': 'vitamin d (25-oh)', 'psa': 'psa (total)', 'upt': 'urine pregnancy test', 'urine albumin': 'albumin (urine)', 'urine protein': 'protein (urine)', 'urine sugar': 'sugar', 'stool colour': 'colour (stool)' };
function plib(n) { const k = String(n || '').toLowerCase().trim(); return PLIB[k] || PLIB[PALIAS[k]] || null }
const fmt = x => x === '' || x == null ? '' : String(x);
const skey = s => /urine/i.test(s || '') ? ' (urine)' : /stool/i.test(s || '') ? ' (stool)' : '';
function plibS(n, sample) { const k = skey(sample); return (k && plib(String(n || '').toLowerCase().trim() + k)) || plib(n) }
/* repair: a urine/stool parameter that got the blood value (e.g. urine Albumin in g/dL 3.5–5.2, stool Colour "Pale yellow") */
function pmSampleFix(pm, sample) { const k = skey(sample); if (!k) return false; const S = plib(String(pm.n || '').toLowerCase().trim() + k), G = plib(pm.n); if (!S || !G || S === G) return false;
  const gRef = G[3] || (G[1] !== '' && G[1] != null ? G[1] + ' – ' + G[2] : '');
  if (!((G[0] && pm.u === G[0]) || (gRef && pm.ref === gRef))) return false;
  pm.u = S[0]; pm.lo = fmt(S[1]); pm.hi = fmt(S[2]); pm.ref = S[3] || (S[1] !== '' ? S[1] + ' – ' + S[2] : ''); delete pm.lof; delete pm.hif; return true }
function pmFill(pm, force, sample) { pmSampleFix(pm, sample); const L = plibS(pm.n, sample); if (!L) return pm; if (!force && pm.ref && (pm.lo === '' || pm.lo == null) && (L[1] !== '' && L[1] != null)) return pm; const [u, lo, hi, ref, lof, hif] = L;
  if (force || !pm.u) pm.u = u; if (force || pm.lo === '' || pm.lo == null) { pm.lo = fmt(lo); pm.hi = fmt(hi) } if (lof !== undefined && (force || pm.lof == null || pm.lof === '')) { pm.lof = fmt(lof); pm.hif = fmt(hif) }
  if (force || !pm.ref) pm.ref = ref || (lo !== '' && lo != null ? lo + ' – ' + hi : ''); return pm }
const MORE_TESTS = [
