 ['Urine Pregnancy Test (UPT)', 'Urine', 100, ['Urine pregnancy test']], ['Serum Beta hCG', 'Serum', 700, ['Serum beta hCG']], ['Stool Routine', 'Stool', 150, ['Colour', 'Consistency', 'Mucus', 'Occult blood', 'Pus cells', 'RBCs', 'Ova', 'Cysts']],
