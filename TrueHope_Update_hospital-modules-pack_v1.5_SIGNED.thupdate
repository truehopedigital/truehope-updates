 ['Dengue Profile (NS1, IgM, IgG)', 'Serum', 900, [P_('Dengue NS1 antigen', '', '', '', 'Negative'), P_('Dengue IgM antibody', '', '', '', 'Negative'), P_('Dengue IgG antibody', '', '', '', 'Negative')]],
 ['Malaria Antigen (rapid)', 'EDTA blood', 250, [P_('P. falciparum', '', '', '', 'Negative'), P_('P. vivax', '', '', '', 'Negative')]],
 ['Blood Group & Rh', 'EDTA blood', 100, [P_('ABO group', '', '', '', ''), P_('Rh (D) type', '', '', '', '')]],
 ['Viral Markers (HIV, HBsAg, HCV)', 'Serum', 700, [P_('HIV I & II', '', '', '', 'Non-reactive'), P_('HBsAg', '', '', '', 'Non-reactive'), P_('Anti-HCV', '', '', '', 'Non-reactive')]],
 ['Thyroid Profile (T3, T4, TSH)', 'Serum', 600, [P_('T3', 'ng/mL', 0.8, 2), P_('T4', 'µg/dL', 5.1, 14.1), P_('TSH', 'µIU/mL', 0.4, 4)]],
 ['Serum Electrolytes', 'Serum', 400, [P_('Sodium', 'mmol/L', 135, 145), P_('Potassium', 'mmol/L', 3.5, 5.1), P_('Chloride', 'mmol/L', 98, 107)]],
 ['PT / INR', 'Citrate', 400, [P_('Prothrombin time', 'sec', 11, 13.5), P_('Control', 'sec'), P_('INR', '', 0.8, 1.2)]]
];
function labSeed() { let ch = false;
  if (!C('labTests').length && !db.settings.labSeeded) { LAB_SEED.forEach(([name, sample, rate, params]) => C('labTests').push({ id: nid('LT'), name, sample, rate, params })); db.settings.labSeeded = true; ch = true }
  if ((db.settings.labLibV || 0) < 2) { const have = new Set(C('labTests').map(t => t.name.toLowerCase())); MORE_TESTS.forEach(([name, sample, rate, ps]) => { if (!have.has(name.toLowerCase())) C('labTests').push({ id: nid('LT'), name, sample, rate, params: ps.map(n => pmFill({ n, u: '', lo: '', hi: '', ref: '' }, 0, sample)) }) });
    C('labTests').forEach(t => (t.params || []).forEach(pm => pmFill(pm, 0, t.sample))); db.settings.labLibV = 2; ch = true }
  if ((db.settings.labLibV || 0) < 3) { /* v1.4 one-time repair of saved tests and reports (results are never changed) */
    C('labTests').forEach(t => (t.params || []).forEach(pm => { pmGenderFix(pm); pmFill(pm, 0, t.sample) }));
    C('labOrders').forEach(o => (o.tests || []).forEach(t => (t.params || []).forEach(pm => { const fixed = pmSampleFix(pm, t.sample); pmGenderFix(pm); pmFill(pm, 0, t.sample);
      if (o.status !== 'Completed' && fixed && !pm.v) pm.v = pmDef(pm) })));
    db.settings.labLibV = 3; ch = true }
  if (ch) save(true) }
/* old CBC/KFT/lipid seeds stored one combined range (e.g. Hb 12–17) — put the male range in lo/hi and the female range in lof/hif */
const OLD_COMBINED = { 'haemoglobin': [12, 17], 'rbc count': [4, 5.5], 'pcv / haematocrit': [36, 50], 'serum creatinine': [0.6, 1.3], 'esr (westergren, 1 hr)': [0, 20], 'hdl cholesterol': [40, 60] };
function pmGenderFix(pm) { const n = String(pm.n || '').toLowerCase().trim(), k = PLIB[n] ? n : PALIAS[n], L = k && PLIB[k]; if (!L || L[4] === undefined) return;
  const o = OLD_COMBINED[k]; if (o && +pm.lo === o[0] && +pm.hi === o[1] && pm.lo !== '') { pm.lo = fmt(L[1]); pm.hi = fmt(L[2]) }
  if (+pm.lo === +L[1] && +pm.hi === +L[2] && pm.lo !== '') { pm.ref = L[3]; pm.lof = fmt(L[4]); pm.hif = fmt(L[5]) } }
const labTests = () => { labSeed(); return C('labTests').slice().sort((a, b) => a.name.localeCompare(b.name)) };
const pmDef = pm => (pm.lo === '' || pm.lo == null) && pm.ref && !/[0-9<>;]/.test(pm.ref) ? pm.ref : '';
const isF = g => /^f/i.test(String(g || ''));
const flag = (pm, v, g) => { const x = parseFloat(v); let lo = pm.lo, hi = pm.hi; if (isF(g) && pm.lof !== undefined && pm.lof !== '') { lo = pm.lof; hi = pm.hif } if (v === '' || v == null || isNaN(x) || lo === '' || hi === '' || lo == null || hi == null) return ''; return x < +lo ? 'L' : x > +hi ? 'H' : '' };
const RES_WORDS = ['Negative', 'Positive', 'Reactive', 'Non-reactive', 'Nil', 'Trace', 'Present', 'Absent', 'Pale yellow', 'Clear', 'Turbid', 'Few', 'A', 'B', 'AB', 'O', 'Positive (+ve)', 'Negative (-ve)'];
function orderPage(kind) { const T = kind === 'lab' ? labTests() : radTests(), pre = kind === 'lab' ? 'lo' : 'ro';
  return `<h2>${kind === 'lab' ? '🧪 New Lab Request' : '🩻 New Radiology Request'}</h2><div class="card">${ppick(pre, ctx.uhid, ctx.adm)}<div class="row" style="margin-top:8px"><div><label>Referred by</label><select id="${pre}_doc">${docOpts()}</select></div><div><label>Payment</label><select id="${pre}_mode">${optList(MODE_OPTS)}</select></div><div><label>Clinical notes / provisional diagnosis</label><input id="${pre}_cl"></div></div></div>
  <div class="card"><h3 style="margin-top:0">Select ${kind === 'lab' ? 'tests' : 'studies'}</h3><input placeholder="Type to filter…" oninput="document.querySelectorAll('.tsel').forEach(l=>l.style.display=l.textContent.toLowerCase().includes(this.value.toLowerCase())?'':'none')" style="max-width:320px;margin-bottom:8px">
   <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:4px 16px">${T.map(t => `<label class="tsel" style="font-weight:400;display:flex;gap:8px;align-items:center"><input type="checkbox" class="${pre}_t" value="${t.id}" style="width:auto" onchange="thm_ordTot('${pre}','${kind}')"> ${esc(t.name)} <span class="muted">${rs(t.rate)}</span></label>`).join('')}</div>
   <p>Total: <b id="${pre}_tot">₹0</b></p><button class="btn" onclick="thm_ordSave('${kind}')">💾 Save request</button></div>`; }
window.thm_ordTot = function (pre, kind) { const T = kind === 'lab' ? C('labTests') : C('radTests'); $('#' + pre + '_tot').textContent = rs([...document.querySelectorAll('.' + pre + '_t:checked')].reduce((s, c) => s + num((T.find(t => t.id === c.value) || {}).rate), 0)) };
window.thm_ordSave = function (kind) { const pre = kind === 'lab' ? 'lo' : 'ro', T = kind === 'lab' ? C('labTests') : C('radTests'); const { p, a } = ppGet(pre); if (!p) { alert('Enter a valid UHID or choose an admitted patient'); return }
  const sel = [...document.querySelectorAll('.' + pre + '_t:checked')].map(c => T.find(t => t.id === c.value)).filter(Boolean); if (!sel.length) { alert('Select at least one'); return }
  const mode = val(pre + '_mode'); if (mode === 'Add to IPD bill' && !a) { alert('Choose the admitted (IPD) patient to add to IPD bill'); return }
  const o = { id: nid(kind === 'lab' ? 'LO' : 'RO'), no: (kind === 'lab' ? 'LAB-' : 'RAD-') + stamp(), date: today(), time: new Date().toTimeString().slice(0, 5), uhid: p.uhid, name: p.name, sex: p.gender || '', admId: a ? a.id : '', doc: val(pre + '_doc'), clin: val(pre + '_cl'), mode, status: 'Pending', by: cur.u,
    tests: sel.map(t => kind === 'lab' ? { tid: t.id, name: t.name, rate: num(t.rate), sample: t.sample, params: (t.params || []).map(x => { const q = pmFill({ ...x }, 0, t.sample); return { ...q, v: pmDef(q) } }) } : { tid: t.id, name: t.name, rate: num(t.rate), mod: t.mod, find: t.tpl || '', imp: t.imp || '' }) };
  o.total = o.tests.reduce((s, t) => s + t.rate, 0); C(kind === 'lab' ? 'labOrders' : 'radOrders').push(o);
  if (mode === 'Add to IPD bill') o.tests.forEach(t => ipdCharge(a, (kind === 'lab' ? 'Lab: ' : 'Radiology: ') + t.name, 1, t.rate));
  audit(kind === 'lab' ? 'Lab request' : 'Radiology request', o.no + ' ' + p.uhid + ' ' + rs(o.total)); save(); toast('Request saved: ' + o.no); go(kind === 'lab' ? 'labres' : 'radres', { id: o.id }) };
function workPage(kind) { if (kind === 'lab') labSeed(); const coll = kind === 'lab' ? 'labOrders' : 'radOrders', st = ctx.s || 'Pending', q = (ctx.q || '').toLowerCase(), pg = kind === 'lab' ? 'labwork' : 'radwork';
  const L = C(coll).filter(o => (st === 'All' || o.status === st) && (!q || (o.no + ' ' + o.name + ' ' + o.uhid).toLowerCase().includes(q))).slice().reverse().slice(0, 150);
  return `<h2>${kind === 'lab' ? '🧪 Lab Worklist' : '🩻 Radiology Worklist'}</h2><div class="card row"><div><label>Search</label><input id="wq" value="${esc(ctx.q || '')}" onkeydown="if(event.key==='Enter')go('${pg}',{q:this.value,s:'${st}'})"></div><div style="max-width:200px"><label>Status</label><select onchange="go('${pg}',{q:val('wq'),s:this.value})">${optList(['Pending', 'Completed', 'All'], st)}</select></div><button class="btn" onclick="go('${kind === 'lab' ? 'laborder' : 'radorder'}')">+ New request</button></div>
  <div class="card"><table><tr><th>No.</th><th>Date</th><th>Patient</th><th>${kind === 'lab' ? 'Tests' : 'Studies'}</th><th>Ref. by</th><th>Status</th><th></th></tr>${L.map(o => `<tr><td>${esc(o.no)}</td><td>${dmy(o.date)} ${esc(o.time || '')}</td><td><b>${esc(o.name)}</b><div class="muted">${esc(o.uhid)}${o.admId && getA(o.admId) ? ' • ' + esc(getA(o.admId).ipdNo) : ''}</div></td><td style="font-size:13px">${o.tests.map(t => esc(t.name)).join(', ')}</td><td>${esc(o.doc)}</td>
   <td><span class="mtag ${o.status === 'Completed' ? 'mt-ok' : 'mt-wa'}">${esc(o.status)}</span></td><td style="white-space:nowrap"><button class="btn sm" onclick="go('${kind === 'lab' ? 'labres' : 'radres'}',{id:'${o.id}'})">${o.status === 'Completed' ? 'Open' : 'Enter report'}</button>${o.status === 'Completed' ? ` <button class="btn sm sec" onclick="${kind === 'lab' ? 'thm_labPrint' : 'thm_radPrint'}('${o.id}')">🖨</button>` : ''}</td></tr>`).join('') || '<tr><td colspan="7" class="muted">Nothing here</td></tr>'}</table></div>`; }
function regPage(kind) { const coll = kind === 'lab' ? 'labOrders' : 'radOrders', f = ctx.f || today(), t = ctx.t || today(), pg = kind === 'lab' ? 'labreg' : 'radreg'; const L = C(coll).filter(o => o.date >= f && o.date <= t);
  return `<h2>📒 ${kind === 'lab' ? 'Laboratory' : 'Radiology'} Register</h2><div class="card row"><div><label>From</label><input id="rg_f2" type="date" value="${f}"></div><div><label>To</label><input id="rg_t2" type="date" value="${t}"></div><button class="btn" onclick="go('${pg}',{f:val('rg_f2'),t:val('rg_t2')})">Show</button><button class="btn sec" onclick="printReport()">🖨 Print</button></div>
  <div class="card" id="rep"><h3 style="text-align:center">${esc(db.settings.hospital)} — ${kind === 'lab' ? 'Laboratory' : 'Radiology'} Register ${dmy(f)} to ${dmy(t)}</h3><p>Requests: <b>${L.length}</b> • ${kind === 'lab' ? 'Tests' : 'Studies'}: <b>${L.reduce((s, o) => s + o.tests.length, 0)}</b> • Pending: <b>${L.filter(o => o.status !== 'Completed').length}</b> • Amount: <b>${rs(L.reduce((s, o) => s + num(o.total), 0))}</b></p>
  <table><tr><th>Sr</th><th>Date</th><th>No.</th><th>Patient / UHID</th><th>Age/Sex</th><th>${kind === 'lab' ? 'Tests' : 'Studies'}</th><th>Ref. by</th><th>Amount</th><th>Payment</th><th>Status</th></tr>${L.map((o, i) => { const p = getP(o.uhid); return `<tr><td>${i + 1}</td><td>${dmy(o.date)}</td><td>${esc(o.no)}</td><td>${esc(o.name)}<div class="muted">${esc(o.uhid)}</div></td><td>${p ? esc(ageText(p) + '/' + (p.gender || '')) : ''}</td><td style="font-size:12px">${o.tests.map(t => esc(t.name)).join(', ')}</td><td>${esc(o.doc)}</td><td>${rs(o.total)}</td><td>${esc(o.mode)}</td><td>${esc(o.status)}</td></tr>` }).join('') || '<tr><td colspan="10" class="muted">No entries</td></tr>'}</table></div>`; }
TH.page('laborder', () => orderPage('lab'));
TH.page('labwork', () => workPage('lab'));
TH.page('labreg', () => regPage('lab'));
TH.page('labres', () => { labSeed(); const o = C('labOrders').find(x => x.id === ctx.id); if (!o) return '<p>Request not found.</p>'; const p = getP(o.uhid), a = o.admId ? getA(o.admId) : null, sx = o.sex || (p && p.gender) || '';
  return `<h2>🧪 Lab Report — ${esc(o.no)}</h2><div class="card">${pStrip(p, a, { name: o.name, date: dmy(o.date), doc: o.doc || ' ', no: o.no })}${o.clin ? `<p class="muted" style="margin-bottom:0">Clinical notes: ${esc(o.clin)}</p>` : ''}</div>
  <p class="muted" style="margin:0 0 10px">✅ Normal word results (Nil, Negative, Non-reactive…) are already filled — change only if abnormal. ✍ Number results must be typed by the technician.</p><datalist id="reswords">${RES_WORDS.map(w => `<option>${w}</option>`).join('')}</datalist>
  ${o.tests.map((t, ti) => `<div class="card"><h3 style="margin-top:0">${esc(t.name)} <span class="muted" style="font-weight:400">${esc(t.sample || '')}</span></h3><table><tr><th>Parameter</th><th style="width:180px">Result</th><th>Unit</th><th>Reference range</th><th></th></tr>
   ${t.params.map((pm, pi) => `<tr><td>${esc(pm.n)}</td><td><input id="lr_${ti}_${pi}" value="${esc(pm.v || '')}" list="reswords" oninput="const f=thm_labFlag(${ti},${pi},this.value);this.nextElementSibling&&0;document.getElementById('lf_${ti}_${pi}').textContent=f;document.getElementById('lf_${ti}_${pi}').className=f?'flag'+f:''"></td><td>${esc(pm.u)}</td><td>${esc(refFor(pm, sx))}</td><td id="lf_${ti}_${pi}" class="${flag(pm, pm.v, sx) ? 'flag' + flag(pm, pm.v, sx) : ''}">${flag(pm, pm.v, sx)}</td></tr>`).join('')}</table>
   <label style="margin-top:8px">Remarks</label><input id="lrm_${ti}" value="${esc(t.rem || '')}"></div>`).join('')}
  <div class="card"><div class="row"><div><label>Sample collected at</label><input id="lr_col" value="${esc(o.col || (dmy(o.date) + ' ' + (o.time || '')))}"></div><div><label>Lab technician</label><input id="lr_tech" value="${esc(o.tech || cur.name || cur.u)}"></div><div><label>Pathologist</label><input id="lr_path" value="${esc(o.path || db.settings.labPath || '')}"></div></div>
   <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><button class="btn" onclick="thm_labSave('${o.id}')">💾 Save</button><button class="btn" onclick="thm_labSave('${o.id}',1)">💾 Save &amp; 🖨 Print report</button><button class="btn sec" onclick="go('labwork')">Back</button>${isM() ? `<button class="btn sec" style="margin-left:auto" onclick="thm_ordDel('labOrders','${o.id}','labwork')">Delete request</button>` : ''}</div></div>`; }, 'labwork');
window.thm_labFlag = (ti, pi, v) => { const o = C('labOrders').find(x => x.id === ctx.id); if (!o) return ''; const p = getP(o.uhid); return flag(o.tests[ti].params[pi], v, o.sex || (p && p.gender)) };
function refFor(pm, g) { const r = pm.ref || ''; if (!/(^|[;,]\s*)M\s/.test(r) || !/[;,]\s*F\s/.test(r)) return r; const sx = String(g || '').trim(); if (!sx) return r;
  const want = isF(sx) ? 'F' : /^m/i.test(sx) ? 'M' : ''; if (!want) return r; const hit = r.split(/[;,]/).map(s => s.trim()).find(s => s.startsWith(want + ' ')); return hit || r }
window.thm_labSave = function (id, pr) { const o = C('labOrders').find(x => x.id === id); let any = false, all = true;
  o.tests.forEach((t, ti) => { t.params.forEach((pm, pi) => { pm.v = val(`lr_${ti}_${pi}`).trim(); if (pm.v) any = true; else all = false }); t.rem = val('lrm_' + ti) });
  Object.assign(o, { col: val('lr_col'), tech: val('lr_tech'), path: val('lr_path') }); db.settings.labPath = o.path;
  o.status = any ? 'Completed' : 'Pending'; if (any && !o.rDate) o.rDate = today() + ' ' + new Date().toTimeString().slice(0, 5);
  if (any && !all && pr && !confirm('Some results are empty. Print anyway?')) { save(); return }
  audit('Lab report saved', o.no); save(); toast('Saved'); if (pr) thm_labPrint(id); else go('labres', { id }) };
window.thm_ordDel = function (coll, id, back) { const o = C(coll).find(x => x.id === id); if (!confirm('Delete request ' + o.no + '?' + (o.mode === 'Add to IPD bill' ? '\n(Remove its charges from the IPD bill by hand.)' : ''))) return; db[coll] = C(coll).filter(x => x.id !== id); audit('Request deleted', o.no); save(); go(back) };
window.thm_labPrint = function (id) { const o = C('labOrders').find(x => x.id === id), p = getP(o.uhid), a = o.admId ? getA(o.admId) : null, sx = o.sex || (p && p.gender) || '';
  prt('LABORATORY REPORT', pStrip(p, a, { name: o.name, date: 'Collected ' + esc(o.col || dmy(o.date)) + ' • Reported ' + (o.rDate ? dmy(o.rDate.slice(0, 10)) + o.rDate.slice(10) : ''), doc: o.doc || ' ', no: o.no }) +
   o.tests.map(t => `<div style="margin-top:10px;font-weight:700;font-size:13px;border-bottom:1px solid #000">${esc(t.name)}${t.sample ? ` <span style="font-weight:400;font-size:11px">(Sample: ${esc(t.sample)})</span>` : ''}</div>
   <table style="width:100%;border-collapse:collapse;font-size:12px"><tr><th style="text-align:left;padding:3px">Parameter</th><th style="text-align:left">Result</th><th style="text-align:left">Unit</th><th style="text-align:left">Reference range</th></tr>${t.params.map(pm => { const f = flag(pm, pm.v, sx); return `<tr><td style="padding:3px">${esc(pm.n)}</td><td style="${f ? 'font-weight:700' : ''}">${esc(pm.v || '')} ${f ? (f === 'H' ? '↑ H' : '↓ L') : ''}</td><td>${esc(pm.u)}</td><td>${esc(refFor(pm, sx))}</td></tr>` }).join('')}</table>${t.rem ? `<p style="font-size:12px;margin:4px 0">Remarks: ${esc(t.rem)}</p>` : ''}`).join('') +
   `<p style="text-align:center;font-size:11px;margin-top:14px">— End of report —</p><div style="display:flex;justify-content:space-between;margin-top:30px;font-size:12px"><div>Lab Technician<br><b>${esc(o.tech || '')}</b></div><div style="text-align:right">Pathologist<br><b>${esc(o.path || '')}</b></div></div>
   <p style="font-size:10px;color:#555;margin-top:10px">Results relate only to the sample tested. Please correlate clinically.</p>`) };
TH.page('labmaster', () => { const e = ctx.id ? C('labTests').find(t => t.id === ctx.id) : ctx.add ? { params: [] } : null;
  return `<h2>⚙ Lab Test Master</h2>${e ? `<div class="card"><div class="row"><div style="flex:2"><label>Test name *</label><input id="lm_n" value="${esc(e.name || '')}"></div><div><label>Sample</label><input id="lm_s" value="${esc(e.sample || '')}"></div><div><label>Rate (₹)</label><input id="lm_r" value="${esc(e.rate ?? '')}"></div></div>
   <label style="margin-top:10px">Parameters — one per line: <code>Name | Unit | Low | High | Reference text</code> (Low/High for auto H/L flag). Leave Unit/Low/High empty for common tests — they fill automatically.</label><textarea id="lm_p" rows="10" style="font-family:Consolas,monospace">${esc((e.params || []).map(p => [p.n, p.u, p.lo, p.hi, p.ref].join(' | ')).join('\n'))}</textarea>
   <div style="margin-top:10px;display:flex;gap:8px"><button class="btn" onclick="thm_lmSave('${e.id || ''}')">💾 Save</button><button class="btn sec" onclick="go('labmaster')">Cancel</button>${e.id ? `<button class="btn sec" style="margin-left:auto" onclick="thm_mDel('labTests','${e.id}','labmaster')">Delete</button>` : ''}</div></div>` : ''}
  <div class="card row"><button class="btn" onclick="go('labmaster',{add:1})">+ Add test</button><button class="btn sec" onclick="thm_labLibFill()">Fill missing units &amp; normal ranges</button><span class="muted">Units and normal ranges fill by themselves for ${Object.keys(PLIB).length} common parameters — just type the parameter name (e.g. Haemoglobin, SGPT, TSH).</span></div><div class="card"><table><tr><th>Test</th><th>Sample</th><th>Parameters</th><th>Rate</th><th></th></tr>${labTests().map(t => `<tr><td><b>${esc(t.name)}</b></td><td>${esc(t.sample)}</td><td>${(t.params || []).length}</td><td>${rs(t.rate)}</td><td><button class="btn sm sec" onclick="go('labmaster',{id:'${t.id}'})">Edit</button></td></tr>`).join('')}</table></div>`; });
window.thm_lmSave = function (id) { const t = id ? C('labTests').find(x => x.id === id) : { id: nid('LT') }; t.name = val('lm_n').trim(); t.sample = val('lm_s'); t.rate = num(val('lm_r')); if (!t.name) { alert('Test name required'); return }
  t.params = val('lm_p').split('\n').map(l => l.split('|').map(x => x.trim())).filter(x => x[0]).map(([n, u, lo, hi, ref]) => ({ n, u: u || '', lo: lo || '', hi: hi || '', ref: ref || (lo && hi ? lo + ' – ' + hi : '') })); if (!t.params.length) t.params = [{ n: t.name, u: '', lo: '', hi: '', ref: '' }]; t.params.forEach(pm => pmFill(pm, 0, t.sample));
  if (!id) C('labTests').push(t); save(); toast('Saved'); go('labmaster') };

window.thm_labLibFill = function () { let n = 0; C('labTests').forEach(t => (t.params || []).forEach(pm => { const b = JSON.stringify(pm); pmFill(pm, 0, t.sample); if (JSON.stringify(pm) !== b) n++ })); save(); alert(n + ' parameters filled with units / normal ranges.'); go('labmaster') };

/* ================= RADIOLOGY MODULE ================= */
TH.addMenu('rad', 'RADIOLOGY MODULE', '🩻');
TH.addMenuItem('rad', 'radorder', 'New Radiology Request');
TH.addMenuItem('rad', 'radwork', 'Worklist / Write Reports');
TH.addMenuItem('rad', 'radreg', 'Radiology Register');
TH.addMenuItem('rad', 'radmaster', 'Study Master & Report Templates');
const RAD_SEED = [
 ['X-Ray Chest PA view', 'X-Ray', 400, 'Both lung fields are clear.\nBoth costophrenic angles are clear.\nBoth hila are normal.\nCardiac size and shape are within normal limits.\nTrachea is central.\nDomes of diaphragm are normal.\nBony thorax and soft tissues appear normal.', 'No significant abnormality detected.'],
 ['X-Ray Knee AP & Lateral', 'X-Ray', 500, 'Bones forming the knee joint show normal density and alignment.\nJoint space is maintained.\nNo fracture or dislocation seen.\nNo osteophytes seen.\nSoft tissues appear normal.', 'Normal study of the knee joint.'],
 ['X-Ray LS Spine AP & Lateral', 'X-Ray', 600, 'Lumbar lordosis is maintained.\nVertebral bodies show normal height, alignment and density.\nIntervertebral disc spaces are maintained.\nPedicles and posterior elements appear normal.\nNo fracture or listhesis seen.', 'Normal study of the lumbosacral spine.'],
 ['X-Ray Abdomen (erect)', 'X-Ray', 450, 'No free gas under the domes of diaphragm.\nNo abnormal air-fluid levels seen.\nBowel gas pattern is normal.\nNo radio-opaque calculus seen.\nPsoas shadows are normal.', 'No significant abnormality detected.'],
 ['USG Abdomen & Pelvis', 'USG', 1000, 'LIVER: Normal in size and echotexture. No focal lesion. Intrahepatic biliary radicles not dilated. Portal vein normal.\nGALL BLADDER: Well distended. Wall thickness normal. No calculus.\nCBD: Normal in calibre.\nPANCREAS: Normal in size and echotexture.\nSPLEEN: Normal in size and echotexture.\nRIGHT KIDNEY: Normal in size and echotexture. Corticomedullary differentiation maintained. No calculus / hydronephrosis.\nLEFT KIDNEY: Normal in size and echotexture. Corticomedullary differentiation maintained. No calculus / hydronephrosis.\nURINARY BLADDER: Well distended. Wall normal. No calculus.\nPROSTATE / UTERUS & OVARIES: Normal in size and echotexture.\nNo free fluid in abdomen. No significant lymphadenopathy.', 'No significant abnormality detected on ultrasound.'],
 ['USG Obstetric (single fetus)', 'USG', 1000, 'Single live intrauterine fetus.\nPresentation: ____\nCardiac activity: Present, FHR ____ bpm\nFetal movements: Present\nBPD ____ mm, HC ____ mm, AC ____ mm, FL ____ mm\nGestational age by USG: ____ weeks ____ days\nEstimated fetal weight: ____ g\nPlacenta: ____ , Grade ____ , not low lying\nLiquor: Adequate, AFI ____ cm\nCervical length: ____ cm, internal os closed', 'Single live intrauterine pregnancy of ____ weeks ____ days. EDD by USG: ____.\n(PC-PNDT: Sex of the fetus has not been determined or disclosed.)'],
 ['USG KUB', 'USG', 800, 'RIGHT KIDNEY: Normal size and echotexture. No calculus / hydronephrosis.\nLEFT KIDNEY: Normal size and echotexture. No calculus / hydronephrosis.\nURETERS: Not dilated.\nURINARY BLADDER: Well distended, wall normal, no calculus.\nPost-void residual: Insignificant.', 'Normal ultrasound of KUB region.'],
 ['CT Brain (plain)', 'CT', 2500, 'Brain parenchyma shows normal grey-white matter differentiation.\nNo intra- or extra-axial haemorrhage.\nNo focal lesion or mass effect.\nVentricles and sulci are normal for age.\nMidline structures are central.\nPosterior fossa structures are normal.\nCalvarium is intact.', 'No significant intracranial abnormality detected.'],
 ['ECG (12 lead)', 'ECG', 200, 'Rhythm: Sinus rhythm\nHeart rate: ____ /min\nAxis: Normal\nPR interval: ____ ms\nQRS duration: ____ ms\nQTc: ____ ms\nST-T changes: None', 'Normal ECG.'],
 ['2D Echo', 'Echo', 1500, 'All cardiac chambers are normal in size.\nNo regional wall motion abnormality.\nLVEF: ____ %\nAll valves are normal in structure and function.\nNo pericardial effusion.\nNo clot or vegetation.\nIAS and IVS intact.', 'Normal 2D echocardiography study. LVEF ____ %.']
];
function radSeed() { if (C('radTests').length || db.settings.radSeeded) return; RAD_SEED.forEach(([name, mod, rate, tpl, imp]) => C('radTests').push({ id: nid('RT'), name, mod, rate, tpl, imp })); db.settings.radSeeded = true; save(true) }
const radTests = () => { radSeed(); return C('radTests').slice().sort((a, b) => (a.mod + a.name).localeCompare(b.mod + b.name)) };
TH.page('radorder', () => orderPage('rad'));
TH.page('radwork', () => workPage('rad'));
TH.page('radreg', () => regPage('rad'));
TH.page('radres', () => { const o = C('radOrders').find(x => x.id === ctx.id); if (!o) return '<p>Request not found.</p>'; const p = getP(o.uhid), a = o.admId ? getA(o.admId) : null;
  return `<h2>🩻 Radiology Report — ${esc(o.no)}</h2><div class="card">${pStrip(p, a, { name: o.name, date: dmy(o.date), doc: o.doc || ' ', no: o.no })}${o.clin ? `<p class="muted" style="margin-bottom:0">Clinical notes: ${esc(o.clin)}</p>` : ''}</div>
  ${o.tests.map((t, ti) => `<div class="card"><h3 style="margin-top:0">${esc(t.name)} <span class="muted" style="font-weight:400">${esc(t.mod || '')}</span></h3><label>Findings</label><textarea id="rf_${ti}" rows="9">${esc(t.find || '')}</textarea><label style="margin-top:8px">Impression</label><textarea id="ri_${ti}" rows="2">${esc(t.imp || '')}</textarea></div>`).join('')}
  <div class="card"><div class="row"><div><label>Reported by (Radiologist / Doctor)</label><input id="rr_by" value="${esc(o.rad || db.settings.radDoc || '')}"></div><div><label>Qualification / Reg. No.</label><input id="rr_q" value="${esc(o.radQ || db.settings.radQ || '')}"></div></div>
   <label style="margin-top:8px;display:flex;gap:8px;align-items:center;font-weight:400"><input id="rr_done" type="checkbox" style="width:auto" ${o.status === 'Completed' || o.status === 'Pending' ? 'checked' : ''}> Report is final (mark Completed)</label>
   <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><button class="btn" onclick="thm_radSave('${o.id}')">💾 Save</button><button class="btn" onclick="thm_radSave('${o.id}',1)">💾 Save &amp; 🖨 Print report</button><button class="btn sec" onclick="go('radwork')">Back</button>${isM() ? `<button class="btn sec" style="margin-left:auto" onclick="thm_ordDel('radOrders','${o.id}','radwork')">Delete request</button>` : ''}</div></div>`; }, 'radwork');
window.thm_radSave = function (id, pr) { const o = C('radOrders').find(x => x.id === id); o.tests.forEach((t, ti) => { t.find = val('rf_' + ti); t.imp = val('ri_' + ti) });
  Object.assign(o, { rad: val('rr_by'), radQ: val('rr_q') }); db.settings.radDoc = o.rad; db.settings.radQ = o.radQ; o.status = $('#rr_done').checked ? 'Completed' : 'Pending'; if (o.status === 'Completed' && !o.rDate) o.rDate = today();
  audit('Radiology report saved', o.no); save(); toast('Saved'); if (pr) thm_radPrint(id); else go('radres', { id }) };
window.thm_radPrint = function (id) { const o = C('radOrders').find(x => x.id === id), p = getP(o.uhid), a = o.admId ? getA(o.admId) : null;
  prt(o.tests.length === 1 ? esc(o.tests[0].name).toUpperCase() + ' — REPORT' : 'RADIOLOGY REPORT', pStrip(p, a, { name: o.name, date: dmy(o.rDate || o.date), doc: o.doc || ' ', no: o.no }) +
   o.tests.map(t => `${o.tests.length > 1 ? `<div style="margin-top:12px;font-weight:700;border-bottom:1px solid #000">${esc(t.name)}</div>` : ''}<p style="font-weight:700;margin:12px 0 4px">FINDINGS:</p><div style="white-space:pre-wrap;font-size:13px;line-height:1.55">${esc(t.find || '')}</div><p style="font-weight:700;margin:12px 0 4px">IMPRESSION:</p><div style="white-space:pre-wrap;font-size:13px;font-weight:700">${esc(t.imp || '')}</div>`).join('') +
   `<div style="margin-top:46px;text-align:right;font-size:12px">${esc(o.rad || '')}<br>${esc(o.radQ || '')}<br><b>Radiologist / Reporting doctor</b></div><p style="font-size:10px;color:#555;margin-top:14px">This report is a professional opinion based on imaging findings; please correlate clinically.</p>`) };
TH.page('radmaster', () => { const e = ctx.id ? C('radTests').find(t => t.id === ctx.id) : ctx.add ? { mod: 'X-Ray' } : null;
  return `<h2>⚙ Radiology Study Master & Templates</h2>${e ? `<div class="card"><div class="row"><div style="flex:2"><label>Study name *</label><input id="rm_n" value="${esc(e.name || '')}"></div><div><label>Modality</label><select id="rm_m">${optList(['X-Ray', 'USG', 'CT', 'MRI', 'ECG', 'Echo', 'Doppler', 'Other'], e.mod)}</select></div><div><label>Rate (₹)</label><input id="rm_r" value="${esc(e.rate ?? '')}"></div></div>
   <label style="margin-top:8px">Normal findings template</label><textarea id="rm_t" rows="8">${esc(e.tpl || '')}</textarea><label style="margin-top:8px">Normal impression</label><textarea id="rm_i" rows="2">${esc(e.imp || '')}</textarea>
   <div style="margin-top:10px;display:flex;gap:8px"><button class="btn" onclick="thm_rmSave('${e.id || ''}')">💾 Save</button><button class="btn sec" onclick="go('radmaster')">Cancel</button>${e.id ? `<button class="btn sec" style="margin-left:auto" onclick="thm_mDel('radTests','${e.id}','radmaster')">Delete</button>` : ''}</div></div>` : ''}
  <div class="card row"><button class="btn" onclick="go('radmaster',{add:1})">+ Add study</button></div><div class="card"><table><tr><th>Study</th><th>Modality</th><th>Rate</th><th></th></tr>${radTests().map(t => `<tr><td><b>${esc(t.name)}</b></td><td>${esc(t.mod)}</td><td>${rs(t.rate)}</td><td><button class="btn sm sec" onclick="go('radmaster',{id:'${t.id}'})">Edit</button></td></tr>`).join('')}</table></div>`; });
window.thm_rmSave = function (id) { const t = id ? C('radTests').find(x => x.id === id) : { id: nid('RT') }; Object.assign(t, { name: val('rm_n').trim(), mod: val('rm_m'), rate: num(val('rm_r')), tpl: val('rm_t'), imp: val('rm_i') }); if (!t.name) { alert('Study name required'); return } if (!id) C('radTests').push(t); save(); toast('Saved'); go('radmaster') };

/* ================= DEPARTMENT LOGINS (roles) & PATIENT REPORTS ================= */
try {
  const NEWR = {
    'Pathology': () => ['laborder', 'labwork', 'labreg', 'labmaster', 'search', 'history', 'reg'],
    'Radiology': () => ['radorder', 'radwork', 'radreg', 'radmaster', 'search', 'history', 'reg'],
    'Pharmacy': () => ['phsale', 'phpur', 'phstock', 'phexp', 'phreg', 'search', 'history'],
    'Store': () => ['stitems', 'stin', 'stout', 'ststock', 'stledger'],
    'HR': () => ['hrstaff', 'hratt', 'hrsal', 'hrtrain', 'hralert'],
    'MRD': () => ['mrdchk', 'search', 'history', 'ipdlist', 'dislist']
  };
  Object.keys(NEWR).forEach(r => { ROLE_TPL[r] = NEWR[r]; if (!ROLES.includes(r)) ROLES.splice(ROLES.indexOf('Master'), 0, r) });
  const add = (r, ks) => { const o = ROLE_TPL[r]; if (o && !o.__mod) { ROLE_TPL[r] = () => [...new Set([...o(), ...ks])]; ROLE_TPL[r].__mod = 1 } };
  add('Doctor', ['laborder', 'labwork', 'radorder', 'radwork', 'mrdchk']);
  add('Nurse', ['laborder', 'labwork', 'radorder', 'radwork', 'phsale']);
} catch (e) { console.error('roles', e) }
/* patient history: lab & radiology reports */
const _hist = P.history;
if (typeof _hist === 'function') P.history = function () {
  const h = _hist.apply(this, arguments), u = ctx.uhid; if (!u) return h;
  const L = C('labOrders').filter(o => o.uhid === u).map(o => ({ o, k: 'lab' })), R = C('radOrders').filter(o => o.uhid === u).map(o => ({ o, k: 'rad' }));
  const A = [...L, ...R].sort((a, b) => (b.o.date + b.o.time).localeCompare(a.o.date + a.o.time)); if (!A.length) return h;
  return h + `<div class="card"><h3 style="margin-top:0">🧪🩻 Lab &amp; Radiology Reports</h3><table><tr><th>Date</th><th>No.</th><th>Tests / studies</th><th>Status</th><th></th></tr>${A.map(({ o, k }) => `<tr><td>${dmy(o.date)}</td><td>${esc(o.no)}</td><td>${o.tests.map(t => esc(t.name)).join(', ')}</td><td><span class="mtag ${o.status === 'Completed' ? 'mt-ok' : 'mt-wa'}">${esc(o.status)}</span></td>
   <td style="white-space:nowrap">${o.status === 'Completed' ? `<button class="btn sm" onclick="${k === 'lab' ? 'thm_labPrint' : 'thm_radPrint'}('${o.id}')">🖨 Print report</button>` : ''}${can(k === 'lab' ? 'labwork' : 'radwork') ? ` <button class="btn sm sec" onclick="go('${k === 'lab' ? 'labres' : 'radres'}',{id:'${o.id}'})">Open</button>` : ''}</td></tr>`).join('')}</table></div>`;
};

/* ================= IPD BILL FINALISE LOCK ================= */
const bLocked = a => !!(a && a.billFinal && !isAdm());
function bMsg(a) { alert('🔒 The bill of ' + a.ipdNo + ' is FINALISED (' + dmy(String(a.billFinal.on).slice(0, 10)) + ' by ' + a.billFinal.by + ').\n\nOnly Admin / Master can change it. Ask Admin to reopen the bill.\n\nबिल फायनल झाले आहे — बदल फक्त Admin करू शकतो.') }
const bAfterFinal = (a, what) => { if (a && a.billFinal) audit('Changed after bill finalised', a.ipdNo + ' — ' + what) };
TH.wrap('addCharge', o => function (id) { const a = getA(id); if (bLocked(a)) { bMsg(a); return } bAfterFinal(a, 'charge added'); return o.apply(this, arguments) });
TH.wrap('setDisc', o => function (id) { const a = getA(id); if (bLocked(a)) { bMsg(a); return } bAfterFinal(a, 'discount changed'); return o.apply(this, arguments) });
TH.wrap('delCharge', o => function (id) { const a = getA(id); if (bLocked(a)) { bMsg(a); return } bAfterFinal(a, 'charge deleted'); return o.apply(this, arguments) });
TH.wrap('delPay', o => function (id) { const a = getA(id); if (bLocked(a)) { bMsg(a); return } bAfterFinal(a, 'payment deleted'); return o.apply(this, arguments) });
TH.wrap('saveDischarge', o => function (id) { const a = getA(id); if (a && a.billFinal && (val('d_d') !== a.dDate || val('d_t') !== a.dTime)) { if (bLocked(a)) { alert('🔒 Bill is finalised — the discharge date / time cannot be changed (it changes bed charges). Ask Admin to reopen the bill.'); return } bAfterFinal(a, 'discharge date/time changed') } return o.apply(this, arguments) });
window.thm_billFinalise = function (id) { const a = getA(id); if (a.status !== 'Discharged') { alert('Discharge the patient first. Bed charges keep adding while the patient is admitted.'); return }
  const T = ipdTotals(a); if (!confirm(`Finalise the bill of ${a.ipdNo}?\n\nNet bill: ₹${Math.round(T.net ?? T.total ?? 0)}  •  Balance: ₹${Math.round(T.bal || 0)}\n\nAfter this only Admin / Master can change charges, discount or discharge date. Payments can still be received.`)) return;
  a.billFinal = { by: cur.u, on: new Date().toISOString() }; (a.billLog = a.billLog || []).push({ act: 'Finalised', by: cur.u, on: a.billFinal.on }); audit('IPD bill finalised', a.ipdNo); save(); toast('Bill finalised'); go('adm', { id }) };
window.thm_billReopen = function (id) { const a = getA(id); if (!isAdm()) { alert('Only Admin / Master can reopen a finalised bill.'); return } const r = prompt('Reason for reopening the bill of ' + a.ipdNo + ':'); if (!r) return;
  (a.billLog = a.billLog || []).push({ act: 'Reopened', by: cur.u, on: new Date().toISOString(), why: r }); a.billFinal = null; audit('IPD bill reopened', a.ipdNo + ' — ' + r); save(); toast('Bill reopened'); go('adm', { id }) };
const _admP = P.adm;
if (typeof _admP === 'function') P.adm = function () {
  const h = _admP.apply(this, arguments), a = getA(ctx.id); if (!a || a.status !== 'Discharged') return h;
  const f = a.billFinal, log = (a.billLog || []).slice(-3).map(l => `${esc(l.act)} ${dmy(l.on.slice(0, 10))} by ${esc(l.by)}${l.why ? ' — ' + esc(l.why) : ''}`).join(' • ');
  const bar = f ? `<div class="card" style="border-color:#067647;background:#ecfdf3"><b style="color:#067647">🔒 Bill FINALISED</b> on ${dmy(f.on.slice(0, 10))} by <b>${esc(f.by)}</b>. Only Admin / Master can change charges, discount or discharge date. Payments can still be received. ${isAdm() ? `<button class="btn sm sec" style="margin-left:8px" onclick="thm_billReopen('${a.id}')">Reopen bill (Admin)</button>` : ''}${log ? `<div class="muted" style="font-size:12px;margin-top:4px">${log}</div>` : ''}</div>`
    : `<div class="card" style="border-color:#b54708;background:#fffaeb"><b style="color:#b54708">⚠ Bill not finalised</b> — check all charges, then finalise. After finalising only Admin can change it. <button class="btn sm" style="margin-left:8px" onclick="thm_billFinalise('${a.id}')">✅ Finalise bill</button>${log ? `<div class="muted" style="font-size:12px;margin-top:4px">${log}</div>` : ''}</div>`;
  if (f && !isAdm()) setTimeout(() => { ['ch_n', 'ch_q', 'ch_r', 'ch_d', 'py_disc'].forEach(k => { const e = document.getElementById(k); if (e) e.disabled = true }); document.querySelectorAll('#main button').forEach(b => { if (/addCharge|setDisc|delCharge|delPay/.test(b.getAttribute('onclick') || '')) { b.disabled = true; b.style.opacity = .45; b.title = 'Bill finalised — Admin only' } }) }, 0);
  const i = h.indexOf('</h2>'); return i > 0 ? h.slice(0, i + 5) + bar + h.slice(i + 5) : bar + h;
};
TH.after('printBill', (r, id) => { try { const a = getA(id); if (a && !a.billFinal) { const pf = document.querySelector('#printArea .pf'); if (pf) pf.insertAdjacentHTML('afterbegin', '<div style="text-align:right;font-size:11px;font-weight:700;border:1px solid #000;display:inline-block;float:right;padding:2px 6px">PROVISIONAL — bill not finalised</div>') } } catch (e) { } });
window.THMOD = { C, mrdPct, stQty, phStock, ym };
/*TH-SIGN:6af9e06b796b7f83d5a904c261463921*/
