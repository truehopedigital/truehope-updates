 ['Iron Studies', 'Serum', 900, ['Serum iron', 'TIBC', 'Serum ferritin']], ['RA Factor', 'Serum', 350, ['RA factor']], ['ASO Titre', 'Serum', 400, ['ASO titre']], ['D-Dimer', 'Citrate', 1200, ['D-dimer']], ['PSA (Total)', 'Serum', 800, ['PSA (total)']],
