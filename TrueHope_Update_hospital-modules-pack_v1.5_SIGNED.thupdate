 ['Urine Routine & Microscopy', 'Urine', 150, [P_('Colour', '', '', '', 'Pale yellow'), P_('Appearance', '', '', '', 'Clear'), P_('pH', '', 4.5, 8), P_('Specific gravity', '', 1.005, 1.03), P_('Albumin', '', '', '', 'Nil'), P_('Sugar', '', '', '', 'Nil'), P_('Pus cells', '/hpf', 0, 5), P_('RBCs', '/hpf', '', '', 'Nil'), P_('Epithelial cells', '/hpf', '', '', 'Few'), P_('Casts', '', '', '', 'Nil'), P_('Crystals', '', '', '', 'Nil')]],
 ['ESR', 'EDTA blood', 100, [P_('ESR (Westergren, 1 hr)', 'mm/hr', 0, 15, 'M 0–15; F 0–20')]],
