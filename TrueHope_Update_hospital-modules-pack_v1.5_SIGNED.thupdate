 ['Kidney Function Test (KFT / RFT)', 'Serum', 600, [P_('Blood urea', 'mg/dL', 15, 45), P_('Serum creatinine', 'mg/dL', 0.7, 1.3, 'M 0.7–1.3; F 0.6–1.1'), P_('Uric acid', 'mg/dL', 3.5, 7.2, 'M 3.5–7.2; F 2.6–6.0'), P_('Sodium', 'mmol/L', 135, 145), P_('Potassium', 'mmol/L', 3.5, 5.1), P_('Chloride', 'mmol/L', 98, 107)]],
