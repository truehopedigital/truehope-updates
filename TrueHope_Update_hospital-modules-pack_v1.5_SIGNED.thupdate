const P_ = (n, u, lo, hi, ref) => ({ n, u: u || '', lo: lo ?? '', hi: hi ?? '', ref: ref || (lo !== undefined && lo !== '' ? lo + ' – ' + hi : '') });
const LAB_SEED = [
 ['Complete Blood Count (CBC)', 'EDTA blood', 300, [P_('Haemoglobin', 'g/dL', 13, 17, 'M 13–17; F 12–15'), P_('Total WBC count', '/cumm', 4000, 11000), P_('Neutrophils', '%', 40, 75), P_('Lymphocytes', '%', 20, 45), P_('Eosinophils', '%', 1, 6), P_('Monocytes', '%', 2, 10), P_('Basophils', '%', 0, 1), P_('RBC count', 'million/cumm', 4.5, 5.5, 'M 4.5–5.5; F 3.8–4.8'), P_('PCV / Haematocrit', '%', 40, 50, 'M 40–50; F 36–46'), P_('MCV', 'fL', 80, 100), P_('MCH', 'pg', 27, 32), P_('MCHC', 'g/dL', 32, 36), P_('Platelet count', 'lakh/cumm', 1.5, 4.5)]],
