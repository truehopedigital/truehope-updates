    }
    function contentH() { var d = frame.contentDocument; return Math.ceil(d.documentElement.getBoundingClientRect().height); }
    function rerender() { scale = 1; measuring = true; broke = false; render(); }
    var broke = false, PAGES = 1, AREA = 0;
    /* move a section that would be cut at the page end to the next page (same in preview and on paper) */

    /* split a long text section line by line: lines that fit stay on this page, the rest continue on the next page */
    function splitSection(d, hit, bnd, info) {
      info = info || {};
      var sy = d.documentElement.scrollTop;
      var hs = d.defaultView.getComputedStyle(hit.tagName === "TR" && hit.cells[0] ? hit.cells[0] : hit);
      var reserve = (parseFloat(hs.paddingBottom) || 0) + (parseFloat(hs.borderBottomWidth) || 0) + 3;
      // lines typed in a box (text with line breaks shown as separate lines): turn each break into <br> so they can be split
      [hit].concat(Array.prototype.slice.call(hit.querySelectorAll("div, td, p, span, pre"))).forEach(function (b) {
        var ws = d.defaultView.getComputedStyle(b).whiteSpace;
        if (!/pre/.test(ws)) return;
        Array.prototype.slice.call(b.childNodes).forEach(function (n) {
          if (n.nodeType !== 3 || n.nodeValue.indexOf("\n") < 0) return;
          var parts = n.nodeValue.replace(/^\n+|\n+$/g, "").split("\n"), frag = d.createDocumentFragment();
          parts.forEach(function (t, i) { if (i) frag.appendChild(d.createElement("br")); frag.appendChild(d.createTextNode(t)); });
          b.replaceChild(frag, n);
        });
      });
      // the element inside that holds the lines (text separated by <br>, or a list of short blocks)
      var boxes = [hit].concat(Array.prototype.slice.call(hit.querySelectorAll("div, td, p, ul, ol, tbody, span, pre")));
      var best = null, bestN = 0;
      boxes.forEach(function (b) {
        var r = b.getBoundingClientRect(); if (r.top + sy >= bnd || r.bottom + sy <= bnd) return;
        var brs = Array.prototype.filter.call(b.childNodes, function (n) { return n.nodeName === "BR"; }).length;
        var blocks = Array.prototype.filter.call(b.children, function (c) { return /^(DIV|P|LI|TR)$/.test(c.tagName) && c.getBoundingClientRect().height < 60; }).length;
        var n = Math.max(brs, blocks >= 3 ? blocks : 0);
        if (n > bestN) { best = b; bestN = n; }
      });
      if (!best || bestN < 3) return false;
      var kids = Array.prototype.slice.call(best.childNodes);
      var useBr = Array.prototype.some.call(kids, function (n) { return n.nodeName === "BR"; });
      // line ends: index of the node that ends each line, and its bottom on the page
      var ends = [];
      if (useBr) {
        kids.forEach(function (n, i) {
          if (n.nodeName !== "BR") return;
          var rg = d.createRange(); rg.setStart(best, 0); rg.setEndBefore(n);
          var rs = rg.getClientRects(); var bt = rs.length ? rs[rs.length - 1].bottom : 0;
          ends.push({ i: i, bottom: bt + sy });
        });
      } else {
        kids.forEach(function (n, i) { if (n.nodeType === 1) ends.push({ i: i, bottom: n.getBoundingClientRect().bottom + sy }); });
        ends.pop();
      }
      var fit = ends.filter(function (e) { return e.bottom <= bnd - reserve; });
      var total = ends.length + 1;
      if (total - fit.length < 2) fit = fit.slice(0, Math.max(0, total - 2));   // never leave a single line alone on the next page
      if (fit.length < 2) { if (ends.length >= 3) info.need = Math.ceil(ends[1].bottom + reserve - bnd) + 2; return false; }   // keep at least 2 lines on each page
      var cut = fit[fit.length - 1].i;                                       // last node that stays on this page
      // build the continuation: a copy of the whole section, then trim both
      var path = [], n2 = best; while (n2 && n2 !== hit) { path.unshift(Array.prototype.indexOf.call(n2.parentNode.childNodes, n2)); n2 = n2.parentNode; }
      var copy = hit.cloneNode(true);
      var cbest = copy; path.forEach(function (ix) { cbest = cbest.childNodes[ix]; });
      var cKids = Array.prototype.slice.call(cbest.childNodes);
      for (var a = 0; a <= cut; a++) cbest.removeChild(cKids[a]);
      while (cbest.firstChild && (cbest.firstChild.nodeName === "BR" || (cbest.firstChild.nodeType === 3 && !cbest.firstChild.nodeValue.trim()))) cbest.removeChild(cbest.firstChild);
      for (var z = kids.length - 1; z > cut; z--) best.removeChild(kids[z]);
      if (useBr && best.lastChild && best.lastChild.nodeName === "BR") best.removeChild(best.lastChild);
