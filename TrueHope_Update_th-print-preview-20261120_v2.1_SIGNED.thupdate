          // the section continues in the same box on the next page
          var info = {}, cont = hit.getBoundingClientRect().height > 50 ? splitSection(d, hit, bnd, info) : false;
          for (var tries = 0, need = info.need; !cont && tries < 3 && need > 0 && need < area * 0.12; tries++) {
            if (!squeeze(d, (k - 1) * area, topOf(hit), need + 2 * tries)) break;
            var info2 = {}; cont = splitSection(d, hit, bnd, info2); need = info2.need || 0;
          }
          if (cont) hit = cont;
          else if (hit.getBoundingClientRect().height > area * 0.85) { hit.setAttribute("data-thpp-skip", "1"); continue; }
        }
        done[k] = true;
