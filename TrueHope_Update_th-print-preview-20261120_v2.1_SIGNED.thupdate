            T2.removeAttribute("id"); T2.style.marginTop = "0";
            var mv = hit; while (mv) { var nx2 = mv.nextSibling; tb2.appendChild(mv); mv = nx2; }
            T2.appendChild(tb2);
            var after = tb.nextSibling; while (after) { var nx3 = after.nextSibling; T2.appendChild(after); after = nx3; }
            T.parentNode.insertBefore(T2, T.nextSibling);
            T.style.marginBottom = "0";
            firstRow = tb2.rows[0]; hit = T2;
