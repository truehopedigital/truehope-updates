      return "@page{" + (s ? "size:" + s + " " + selOri.value + ";" : "") + "margin:" + MARGIN + "mm}";
    }
    function render() {
      var d = dims();
      page.style.width = mm(d.w) + "px";
      page.style.padding = mm(MARGIN) + "px";
