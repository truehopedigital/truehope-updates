          if (isTR) {
            first = d.createElement("tr"); first.className = "thpp-h2";
            first.innerHTML = '<td colspan="99" style="border:0 !important;padding:0 !important;background:transparent">' + inner + "</td>";
          } else { first = d.createElement("div"); first.className = "thpp-h2"; first.style.border = "0"; first.innerHTML = inner; }
          hit.parentNode.insertBefore(first, hit);
        }
        // spacer (preview only) + real page break (paper)
        var sp;
        if (isTR) { sp = d.createElement("tr"); sp.className = "thpp-sp"; sp.innerHTML = '<td colspan="99" style="height:1px;padding:0;border:0;background:transparent"></td>'; }
        else { sp = d.createElement("div"); sp.className = "thpp-sp"; sp.style.height = "1px"; }
        first.parentNode.insertBefore(sp, first);
        first.style.breakBefore = "page"; first.style.pageBreakBefore = "always"; first.setAttribute("data-thpp-brk", "1");
        // the section on the new page gets a top line if it had none
        var rowEl = firstRow || (isTR ? hit : null);
        var hs = d.defaultView.getComputedStyle(rowEl && rowEl.cells[0] ? rowEl.cells[0] : hit);
        if (!parseFloat(hs.borderTopWidth) && (parseFloat(hs.borderBottomWidth) || parseFloat(hs.borderLeftWidth))) {
          var bw = parseFloat(hs.borderBottomWidth) ? hs.borderBottomWidth + " " + hs.borderBottomStyle + " " + hs.borderBottomColor : hs.borderLeftWidth + " " + hs.borderLeftStyle + " " + hs.borderLeftColor;
          if (rowEl) Array.prototype.forEach.call(rowEl.cells, function (c) { c.style.borderTop = bw; }); else hit.style.borderTop = bw;
        }
