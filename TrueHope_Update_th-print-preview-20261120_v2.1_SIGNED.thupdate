          if (!L && !R) continue;
          var bl = cs.borderLeftWidth + " " + cs.borderLeftStyle + " " + cs.borderLeftColor, br = cs.borderRightWidth + " " + cs.borderRightStyle + " " + cs.borderRightColor;
          var bt = parseFloat(cs.borderTopWidth) ? cs.borderTopWidth + " " + cs.borderTopStyle + " " + cs.borderTopColor : "";
          var bb = parseFloat(cs.borderBottomWidth) ? cs.borderBottomWidth + " " + cs.borderBottomStyle + " " + cs.borderBottomColor : "";
          var kids = Array.prototype.filter.call(an.children, function (c) { return !c.classList.contains("thpp-sp") && !c.classList.contains("thpp-h2") && d.defaultView.getComputedStyle(c).display !== "none"; });
          if (!kids.length) continue;
          kids.forEach(function (c, i) {
            if (L) c.style.borderLeft = bl; if (R) c.style.borderRight = br;
            if (i === 0 && bt) c.style.borderTop = bt;
            if (i === kids.length - 1 && bb) c.style.borderBottom = bb;
          });
          an.style.border = "0"; an.setAttribute("data-thpp-moved", "1");
          break;
        }
        // finally make the preview land exactly on the page start
        for (var al = 0; al < 3; al++) {
          var off = Math.round(bnd - topOf(first));
          if (!off) break;
          var cell = isTR ? sp.firstChild : sp, hh = Math.max(0, parseFloat(cell.style.height) + off);
          cell.style.height = hh + "px";
        }
        changed = true;
      }
      if (changed) {
        var st = d.createElement("style"); st.textContent = "@media print{.thpp-sp{display:none !important}}"; d.head.appendChild(st);
        lastDoc = "<!DOCTYPE html>" + d.documentElement.outerHTML;
      }
      return changed;
    }
    function fit() {
      var d = dims(), area = mm(d.h - 2 * MARGIN), h = 0;
      try { h = contentH(); } catch (e) {}
      if (measuring) {
        measuring = false;
        var mode = selFit.value, need = h > area + 2;
        var want = need && (mode === "one" || (mode === "auto" && h <= area * 1.35));
        if (want) {
          scale = Math.max(0.4, Math.floor(area / h * 0.985 * 100) / 100);
          render();                                    // load again with the shrink applied
          return;
        }
      }
      if (scale === 1 && h > area + 2 && !broke) { broke = true; if (smartBreaks(area)) { try { h = contentH(); } catch (e) {} } }
      frame.style.height = Math.max(h, area) + "px";
      Array.prototype.slice.call(page.querySelectorAll(".thpp-brk")).forEach(function (x) { x.remove(); });
      var pages = Math.max(1, Math.ceil((h - 2) / area));
      PAGES = pages; AREA = area;
      var pbp = ov.querySelector(".thpp-pbp"); if (pbp) pbp.style.display = pages > 1 && DIRECT ? "inline-flex" : "none";
      for (var i = 1; i < pages; i++) {
        var ln = document.createElement("div"); ln.className = "thpp-brk";
        ln.style.top = (mm(MARGIN) + i * area) + "px";
        ln.innerHTML = "<span>Page " + (i + 1) + " starts here</span>";
        page.appendChild(ln);
      }
      var pb = ov.querySelector(".thpp-pages");
      pb.textContent = pages + (pages > 1 ? " pages" : " page") + (scale < 1 ? " · " + Math.round(scale * 100) + "%" : "");
      pb.className = "thpp-pages" + (pages > 1 ? " two" : "");
      pb.title = pages > 1 ? "Content goes to " + pages + " pages. Choose 'Fit to 1 page' to print on one page." : "";
      page.style.transform = "scale(" + zoom + ")";
      page.style.marginBottom = ((zoom - 1) * page.offsetHeight) + "px";
      ov.querySelector(".thpp-zoom").textContent = Math.round(zoom * 100) + "%";
    }
    frame.addEventListener("load", function () { setTimeout(fit, 60); });

    function close() {
      document.removeEventListener("keydown", keys, true);
      if (ov.parentNode) ov.parentNode.removeChild(ov);
    }
    function winPrint() {
      try { frame.contentWindow.focus(); frame.contentWindow.print(); }
      catch (e) { close(); nativePrint(); }
    }
    var busy = false;
    function pageDoc(n) {      // the document cut to one page (n = 1, 2, …)
      var a = Math.floor(AREA) - 2;
      return lastDoc.replace(/<body([^>]*)>/i, '<body$1><div style="height:' + a + 'px;overflow:hidden"><div style="margin-top:-' + Math.round((n - 1) * AREA) + 'px">')
        .replace(/<\/body>/i, "</div></div></body>")
        .replace("</head>", "<style>.thpp-sp{display:block !important}[data-thpp-brk]{break-before:auto !important;page-break-before:auto !important;break-after:auto !important;page-break-after:auto !important}</style></head>");
    }
    function waitOK(n, total) {
      return new Promise(function (res) {
        var w = document.createElement("div"); w.className = "thpp-wait";
        w.innerHTML = "<div><h3>🖨 Page " + (n - 1) + " of " + total + " printed</h3><p><b>Back side (मागे-पुढे):</b> turn the same sheet over and put it back in the tray.<br><b>New sheet:</b> put the next sheet / letterhead.<br>Then click <b>OK</b> to print <b>page " + n + "</b>.</p>" +
          '<button type="button" class="cx">Stop</button><button type="button" class="go">OK — print page ' + n + "</button></div>";
        document.body.appendChild(w);
        w.querySelector(".go").onclick = function () { w.remove(); res(true); };
        w.querySelector(".cx").onclick = function () { w.remove(); res(false); };
        setTimeout(function () { w.querySelector(".go").focus(); }, 30);
      });
    }
    async function printPages() {
      var prn = ov.querySelector(".thpp-prn"), msg = ov.querySelector(".thpp-msg"), btn = ov.querySelector(".thpp-print");
      busy = true; btn.disabled = true; msg.textContent = "";
      var total = PAGES;
      for (var n = 1; n <= total; n++) {
        if (n > 1 && !(await waitOK(n, total))) break;
        btn.textContent = "Printing page " + n + "…";
        var r = null;
        try { r = await window.thDesktop.directPrint({ html: pageDoc(n), deviceName: prn.value, pageSize: selSize.value || "A4", landscape: selOri.value === "landscape", copies: 1 }); } catch (e) { r = { ok: false, error: String(e) }; }
        if (!r || !r.ok) { msg.textContent = "Page " + n + " not printed: " + ((r && r.error) || "error"); busy = false; btn.disabled = false; btn.textContent = "Print (Ctrl+P)"; return; }
      }
      busy = false; btn.disabled = false; btn.textContent = "Print (Ctrl+P)";
      if (prn.value) lsSet(LS_PRN, prn.value);
      try { toast("Printed ✔"); } catch (e) {}
      close();
    }
    function doPrint() {
      if (!DIRECT) return winPrint();
      if (busy) return;
      var one = ov.querySelector(".thpp-one");
      if (one && one.checked && PAGES > 1) { try { localStorage.setItem("thPrintOneByOne", "1"); } catch (e) {} return printPages(); }
      try { localStorage.setItem("thPrintOneByOne", one && one.checked ? "1" : "0"); } catch (e) {}
      var prn = ov.querySelector(".thpp-prn"), msg = ov.querySelector(".thpp-msg"), btn = ov.querySelector(".thpp-print");
      var cp = Math.min(20, Math.max(1, parseInt(ov.querySelector(".thpp-cp").value, 10) || 1));
      busy = true; btn.disabled = true; btn.textContent = "Printing…"; msg.textContent = "";
      window.thDesktop.directPrint({
        html: lastDoc, deviceName: prn.value, pageSize: selSize.value || "A4",
        landscape: selOri.value === "landscape", copies: cp
      }).then(function (r) {
        busy = false; btn.disabled = false; btn.textContent = "Print (Ctrl+P)";
        if (r && r.ok) {
          if (prn.value) lsSet(LS_PRN, prn.value);
          if (typeof toast === "function") { try { toast("Sent to printer ✔"); } catch (e) {} }
          close();
        } else {
          msg.textContent = "Not printed: " + ((r && r.error) || "error") + " — check printer / try Windows dialog";
        }
      }, function (e) {
        busy = false; btn.disabled = false; btn.textContent = "Print (Ctrl+P)";
        msg.textContent = "Not printed — try Windows dialog";
      });
    }
    if (DIRECT) {
      ov.querySelector(".thpp-win").onclick = winPrint;
      window.thDesktop.printers().then(function (list) {
        var sel = ov.querySelector(".thpp-prn"), saved = lsGet(LS_PRN), html = "", pick = "";
        list = list || [];
        list.forEach(function (p) { if (p.name === saved) pick = saved; });
        if (!pick) list.forEach(function (p) { if (p.isSaved) pick = p.name; });
        if (!pick) list.forEach(function (p) { if (p.isAuto) pick = p.name; });
        if (!pick) list.forEach(function (p) { if (p.isDefault) pick = p.name; });
        list.forEach(function (p) {
          html += '<option value="' + String(p.name).replace(/&/g, "&amp;").replace(/"/g, "&quot;") + '"' + (p.name === pick ? " selected" : "") + ">" +
            String(p.displayName).replace(/&/g, "&amp;").replace(/</g, "&lt;") + (p.isDefault ? " (default)" : "") + "</option>";
        });
        sel.innerHTML = html || '<option value="">Default printer</option>';
      }, function () { ov.querySelector(".thpp-prn").innerHTML = '<option value="">Default printer</option>'; });
    }
    function keys(e) {
      if (e.key === "Escape") { e.preventDefault(); close(); }
      else if ((e.ctrlKey || e.metaKey) && (e.key === "p" || e.key === "P")) { e.preventDefault(); doPrint(); }
    }
    document.addEventListener("keydown", keys, true);

    selSize.onchange = rerender;
    selOri.onchange = rerender;
    selHead.onchange = function () { try { localStorage.setItem("thPage2Head2", selHead.value); } catch (e) {} rerender(); };
    selFit.onchange = function () { try { localStorage.setItem("thPrintFit", selFit.value); } catch (e) {} rerender(); };
    ov.querySelector(".thpp-zp").onclick = function () { zoom = Math.min(2, zoom + 0.1); fit(); };
    ov.querySelector(".thpp-zm").onclick = function () { zoom = Math.max(0.4, zoom - 0.1); fit(); };
    ov.querySelector(".thpp-print").onclick = doPrint;
    ov.querySelector(".thpp-close").onclick = close;

    render();
  }

  window.print = function () {
    try {
      var pa = document.getElementById("printArea");
      (window.thPrintHooks || []).forEach(function (f) { try { if (pa) f(pa); } catch (e) { console.warn("print hook", e); } });
      // copy the page right now (the software may clear it straight after calling print)
      var html = pa && pa.innerHTML.trim() ? '<div id="printArea">' + pa.innerHTML + "</div>" : "";
      if (!html) return nativePrint();
      preview(html, document.body.className);
    } catch (e) {
      console.error(e);
      nativePrint();
    }
  };
})();
