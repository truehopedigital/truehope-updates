    /* tighten the empty spacing (padding / margins) of boxes on one page by up to 60% to win `need` px; font size is not changed */
    function squeeze(d, from, to, need) {
      var sy = d.documentElement.scrollTop, list = [], total = 0;
      Array.prototype.forEach.call(d.querySelectorAll("#printArea *, body > *"), function (e) {
        if (e.classList && e.classList.contains("thpp-sp")) return;
