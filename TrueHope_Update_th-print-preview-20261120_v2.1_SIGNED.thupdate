/*TRUEHOPE-UPDATE {"id":"th-print-preview-20261120","name":"Print Preview","version":"2.1","date":"2026-11-20","description":"v2.1: page 2 keeps the header space blank by default (no hospital name repeated). v2.0: a section that does not fit continues in the SAME box on the next page (no repeated heading, no cut lines); page 2 starts below the hospital header (repeat header / blank space for letterhead / none). v1.9: no blank space at the page end — if the next section does not fit, the empty spacing inside the boxes on that page is tightened a little (font size unchanged) so its heading and first lines fit; the rest continues (contd.). v1.8: also splits sections whose lines are plain text lines (no <br>). v1.7: long sections split line-by-line at the page end (rest continues on the next page with (contd.) heading) so page 1 is filled; small blocks like doctor sign stay whole. v1.6: page break keeps every box closed (no empty box at the bottom of page 1, full top line on page 2). v1.5: clean page breaks (a section that would be cut moves whole to the next page) and One-page-at-a-time printing (waits for OK before the next page). v1.4: runs print hooks (NABH capital drug names / high-alert red). Preview now matches the printed page exactly (same margins), always fits the print on ONE page by default (shrinks to fit), shows page count and where page 2 would start. Print preview with printer list, copies and Direct Print (no Windows print dialog - fixes 0x8000ffff on old printer drivers)."} */
(function () {
  if (window.__thPrintPreview) return;
  window.__thPrintPreview = true;

  var nativePrint = window.print.bind(window);

  TH.css([
    ".thpp-ov{position:fixed;inset:0;z-index:2147483000;background:#525659;display:flex;flex-direction:column;font-family:'Segoe UI',Arial,sans-serif}",
    ".thpp-bar{display:flex;align-items:center;gap:10px;padding:8px 14px;background:#1e293b;color:#fff;box-shadow:0 2px 8px rgba(0,0,0,.3);flex-wrap:wrap}",
    ".thpp-bar b{font-size:15px;margin-right:auto;letter-spacing:.3px}",
    ".thpp-bar select,.thpp-bar button{height:32px;border-radius:7px;border:1px solid #475569;background:#334155;color:#fff;padding:0 10px;font-size:13px;cursor:pointer}",
    ".thpp-bar button.thpp-print{background:#16a34a;border-color:#16a34a;font-weight:700;padding:0 18px}",
    ".thpp-bar button.thpp-close{background:#b91c1c;border-color:#b91c1c}",
    ".thpp-bar .thpp-zoom{min-width:52px;text-align:center;font-size:13px}",
    ".thpp-body{flex:1;overflow:auto;padding:24px 0;display:flex;justify-content:center;align-items:flex-start}",
    ".thpp-page{background:#fff;box-shadow:0 4px 24px rgba(0,0,0,.5);transform-origin:top center;position:relative;box-sizing:border-box}",
    ".thpp-brk{position:absolute;left:0;right:0;border-top:2px dashed #dc2626;pointer-events:none}",
    ".thpp-brk span{position:absolute;right:6px;top:-20px;background:#dc2626;color:#fff;font-size:11px;padding:1px 8px;border-radius:10px}",
    ".thpp-bar{flex-wrap:nowrap !important;overflow-x:auto}",
    ".thpp-bar .thpp-pages{font-size:12px;padding:3px 9px;border-radius:12px;background:#16a34a;color:#fff;white-space:nowrap}",
    ".thpp-bar .thpp-pages.two{background:#dc2626}",
    ".thpp-sp{display:block}",
    ".thpp-wait{position:fixed;inset:0;z-index:2147483600;background:rgba(15,23,42,.6);display:flex;align-items:center;justify-content:center}",
    ".thpp-wait div{background:#fff;border-radius:16px;padding:22px 26px;max-width:420px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.4);font-family:inherit}",
    ".thpp-wait h3{margin:0 0 6px;color:#0b2545}.thpp-wait p{margin:0 0 16px;color:#334155;font-size:14px}",
    ".thpp-wait button{height:42px;border-radius:10px;padding:0 20px;font-weight:700;font-size:15px;cursor:pointer;margin:0 5px;border:1px solid #cbd5e1;background:#fff}",
    ".thpp-wait button.go{background:#16a34a;border-color:#16a34a;color:#fff}",
    ".thpp-page iframe{border:0;display:block;width:100%;background:#fff}",
    ".thpp-bar select,.thpp-bar input,.thpp-bar button{width:auto !important;flex:0 0 auto !important;margin:0 !important}",
    ".thpp-bar select.thpp-prn{max-width:190px !important}",
    ".thpp-bar span{color:#cbd5e1;font-size:13px}",
    ".thpp-bar input.thpp-cp{width:52px;height:32px;border-radius:7px;border:1px solid #475569;background:#334155;color:#fff;text-align:center;font-size:13px}",
    ".thpp-bar button.thpp-win{background:#475569}",
    ".thpp-msg{font-size:12px;color:#fde68a;min-width:120px}"
  ].join(""));

  var DIRECT = !!(window.thDesktop && typeof window.thDesktop.directPrint === "function");
  var LS_PRN = "thPrintPrinter";
  function lsGet(k) { try { return localStorage.getItem(k) || ""; } catch (e) { return ""; } }
  function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

  var SIZES = { A4: [210, 297], A5: [148, 210], Letter: [216, 279], Legal: [216, 356] };
