        var t = r.top + sy; if (t < from - 1 || t + r.height > to + 1) return;
        var cs = d.defaultView.getComputedStyle(e);
        if (cs.display === "inline") return;
        var v = { e: e, pt: parseFloat(cs.paddingTop) || 0, pb: parseFloat(cs.paddingBottom) || 0, mt: Math.max(0, parseFloat(cs.marginTop) || 0), mb: Math.max(0, parseFloat(cs.marginBottom) || 0) };
        var sum = v.pt + v.pb + v.mt + v.mb; if (sum < 1) return;
        list.push(v); total += sum;
      });
      if (!list.length || total * 0.6 < need) return false;
      var f = Math.min(0.6, need / total + 0.02);
      list.forEach(function (v) {
        var s = v.e.style;
        if (v.pt) s.setProperty("padding-top", (v.pt * (1 - f)).toFixed(1) + "px", "important");
        if (v.pb) s.setProperty("padding-bottom", (v.pb * (1 - f)).toFixed(1) + "px", "important");
        if (v.mt) s.setProperty("margin-top", (v.mt * (1 - f)).toFixed(1) + "px", "important");
        if (v.mb) s.setProperty("margin-bottom", (v.mb * (1 - f)).toFixed(1) + "px", "important");
      });
      return true;
    }
    /* the hospital header at the top of page 1 (printed again at the top of page 2, 3 …) */
    function headerInfo(d) {
      var root = d.getElementById("printArea") || d.body;
      var re = /(SUMMARY|FORM|BILL|RECEIPT|CERTIFICATE|RECORD|PRESCRIPTION|REPORT|SHEET|CONSENT|SLIP|CARD|REGISTER|VOUCHER|LETTER|NOTE|CHART|MAR\b)/i;
      var t = Array.prototype.filter.call(root.querySelectorAll("h1,h2,h3,h4,div,p,b,strong,td,span"), function (e) {
        var x = (e.textContent || "").trim();
        return x.length > 3 && x.length < 90 && e.children.length < 4 && re.test(x) && x === x.toUpperCase();
      })[0];
      if (!t) return null;
      var node = t; while (node.parentElement && node.parentElement !== root && !node.previousElementSibling) node = node.parentElement;
      if (!node.previousElementSibling) return null;
      var hs = [], p = node.previousElementSibling; while (p) { hs.unshift(p); p = p.previousElementSibling; }
      var sy = d.documentElement.scrollTop, top = hs[0].getBoundingClientRect().top + sy, bot = node.getBoundingClientRect().top + sy;
      if (bot - top < 20 || bot - top > area0 * 0.4) return null;
      return { html: hs.map(function (h) { return h.outerHTML; }).join(""), h: Math.round(bot - top) };
    }
    var area0 = 1000;
    function smartBreaks(area) {
      var d = frame.contentDocument, changed = false, done = {};
      area0 = area;
      var mode = (selHead && selHead.value) || "space";
      var HI = mode === "none" ? null : headerInfo(d);
      var BLOCK = /^(DIV|SECTION|TR|LI|P|TABLE|FIELDSET|UL|OL|H1|H2|H3|H4|H5|H6|IMG|TBODY|THEAD)$/;
      function sy0() { return d.documentElement.scrollTop; }
      function topOf(e) { return e.getBoundingClientRect().top + sy0(); }
      function crosses(e, bnd) { var r = e.getBoundingClientRect(), t = r.top + sy0(); return r.height > 0 && t < bnd - 2 && t + r.height > bnd + 2; }
      function blockKids(e) { return Array.prototype.filter.call(e.children, function (c) { return BLOCK.test(c.tagName) && c.getBoundingClientRect().height > 0 && !c.classList.contains("thpp-sp"); }); }
      for (var guard = 0; guard < 40; guard++) {
        var H = contentH(), k, hit = null, bnd = 0, clean = false;
        for (k = 1; k * area < H - 4; k++) {
          if (done[k]) continue;
          bnd = k * area;
          var chain = [], cur = d.body;
          while (cur) {
            var nx = blockKids(cur).filter(function (c) { return crosses(c, bnd); })[0];
            if (!nx) break;
            chain.push(nx); cur = nx;
          }
          var last = chain[chain.length - 1] || d.getElementById("printArea") || d.body;
          var kidsL = blockKids(last);
          if (!chain.length || kidsL.length >= 2 && !kidsL.some(function (c) { return crosses(c, bnd); })) {
            // page end falls between two sections: the first section of the next page
            var nxt = kidsL.filter(function (c) { return topOf(c) >= bnd - 3; })[0];
            if (!nxt) { done[k] = true; continue; }
            hit = nxt; clean = true; break;
          }
          var sec = null;
          for (var ci = chain.length - 1; ci >= 0; ci--) {
            var e = chain[ci];
            if (/^(TBODY|THEAD|TABLE)$/.test(e.tagName) && ci < chain.length - 1) continue;
            if (e.getAttribute("data-thpp-skip") || e.id === "printArea") continue;
            if (blockKids(e.parentElement).length >= 3 || e.tagName === "TR") { sec = e; break; }
          }
          var deep = chain[chain.length - 1];
          if (!sec && deep && !blockKids(deep).length) sec = deep;
          if (sec && (topOf(sec) > (k - 1) * area + 4)) { hit = sec; break; }
          done[k] = true;
        }
        if (!hit) break;
