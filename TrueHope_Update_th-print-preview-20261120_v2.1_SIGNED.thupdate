    var frame = ov.querySelector("iframe"), page = ov.querySelector(".thpp-page");
    var selSize = ov.querySelector(".thpp-size"), selOri = ov.querySelector(".thpp-ori");
    var zoom = 1, lastDoc = "";

    var MARGIN = 8;                                   // mm — same in preview and on paper
    var selFit = ov.querySelector(".thpp-fit"), selHead = ov.querySelector(".thpp-head");
    try { selHead.value = localStorage.getItem("thPage2Head2") || "space"; } catch (e) {}
    try { var oneBox = ov.querySelector(".thpp-one"); if (oneBox) oneBox.checked = localStorage.getItem("thPrintOneByOne") === "1"; } catch (e) {}
    try { selFit.value = localStorage.getItem("thPrintFit") || "one"; } catch (e) {}
    var scale = 1, measuring = true;
    function dims() {
