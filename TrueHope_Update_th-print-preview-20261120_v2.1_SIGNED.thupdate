      '<select class="thpp-head" title="Top of page 2, 3 …"><option value="space">Page 2: blank space (no name)</option><option value="repeat">Page 2: hospital header</option><option value="none">Page 2: no header</option></select>' +
      '<span class="thpp-pages">1 page</span>' +
      '<label class="thpp-pbp" title="Print page 1, wait, then click OK for page 2" style="display:none;align-items:center;gap:5px;font-size:12.5px;color:#e2e8f0;white-space:nowrap"><input type="checkbox" class="thpp-one" style="width:auto !important;margin:0"> One page at a time (front / back)</label>' +
      '<button type="button" class="thpp-zm">−</button><span class="thpp-zoom">100%</span><button type="button" class="thpp-zp">+</button>' +
      (DIRECT ? '<select class="thpp-prn" title="Printer"><option value="">Loading printers…</option></select>' +
